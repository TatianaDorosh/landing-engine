---
import type { Locale } from "../../config/types";
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

interface PackageItem {
	name: string;
	price: number;
	text: string;
	included: string[];
	excluded: string[];
	featured?: boolean;
}

interface PackageNoteLink {
	text: string;
	linkLabel: string;
	href: string;
}

interface Props {
	title: string;
	text: string;
	currency: string;
	includedLabel: string;
	excludedLabel: string;
	items: PackageItem[];
	notes: Array<string | PackageNoteLink>;
	locale?: Locale;
	bookingHref?: string;
}

const {
	title,
	text,
	currency,
	includedLabel,
	excludedLabel,
	items,
	notes,
	locale = "uk",
	bookingHref = "#booking",
} = Astro.props;
const ui = getUi(locale);

function money(price: number) {
	const formatted = String(price).replace(/\B(?=(\d{3})+(?!\d))/g, "\u00a0");
	return `${formatted}\u00a0${currency}`;
}

function isLink(note: string | PackageNoteLink): note is PackageNoteLink {
	return typeof note !== "string";
}
---

<section id="prices" data-block="prices-packages" class="scroll-mt-24">
	<div class="mx-auto max-w-6xl min-w-0 px-4 py-12 xl:px-8">
		<h2 class="text-3xl">{typograf(title)}</h2>
		<p class="mt-4 max-w-[760px] font-body text-base leading-relaxed">{typograf(text)}</p>

		<ul class="mt-8 grid list-none items-stretch gap-4 p-0 lg:grid-cols-3">
			{
				items.map((item) => (
					<li class="h-full min-w-0">
						<article
							class:list={[
								"flex h-full flex-col rounded-theme border p-5",
								item.featured ? "border-primary bg-primary text-primary-contrast" : "border-border bg-surface",
							]}
						>
							<h3 class="font-body text-lg font-semibold">{typograf(item.name)}</h3>
							<p class:list={["mt-3 font-heading text-[28px] leading-none", item.featured ? "text-primary-contrast" : "text-primary"]}>
								{money(item.price)}
							</p>
							<p class="mt-4 font-body text-[15px] leading-[1.5]">{typograf(item.text)}</p>
							<p class="mt-4 font-body text-[15px] font-semibold leading-[1.5]">{includedLabel}</p>
							<ul class="mt-2 flex list-none flex-col gap-2 p-0">
								{item.included.map((line) => (
									<li class="flex items-start gap-2">
										<span class:list={["mt-0.5 inline-flex h-5 w-5 shrink-0", item.featured ? "text-primary-contrast" : "text-primary"]} aria-hidden="true">
											<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<path d="M20 6 9 17l-5-5" />
											</svg>
										</span>
										<span class="min-w-0 font-body text-[15px] leading-[1.5]">{typograf(line)}</span>
									</li>
								))}
							</ul>
							<p class="mt-4 font-body text-[15px] font-semibold leading-[1.5]">{excludedLabel}</p>
							<ul class="mt-2 flex list-none flex-col gap-2 p-0">
								{item.excluded.map((line) => (
									<li class="flex items-start gap-2">
										<span class:list={["mt-0.5 inline-flex h-5 w-5 shrink-0", item.featured ? "text-primary-contrast" : "text-muted"]} aria-hidden="true">
											<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<path d="M18 6 6 18" />
												<path d="m6 6 12 12" />
											</svg>
										</span>
										<span class="min-w-0 font-body text-[15px] leading-[1.5]">{typograf(line)}</span>
									</li>
								))}
							</ul>
							<div class="mt-auto pt-6">
								<a
									href={bookingHref}
									class:list={[
										"inline-flex min-h-11 w-full items-center justify-center rounded-theme px-5 lg:w-auto",
										item.featured ? "bg-surface text-text" : "bg-primary text-primary-contrast",
									]}
								>
									{ui.buttons.choose}
								</a>
							</div>
						</article>
					</li>
				))
			}
		</ul>

		<ul class="mt-8 max-w-[760px] list-disc space-y-2 pl-5 font-body text-[15px] leading-[1.5]">
			{
				notes.map((note) =>
					isLink(note) ? (
						<li class="break-words">
							{typograf(note.text)}{" "}
							<a href={note.href} class="text-primary underline underline-offset-2">
								{note.linkLabel}
							</a>
						</li>
					) : (
						<li class="break-words">{typograf(note)}</li>
					),
				)
			}
		</ul>
	</div>
</section>
