---
import "../styles/global.css";
import DemoModal from "../components/DemoModal.astro";
import type { SiteConfig } from "../config/types";

interface Props {
	config: SiteConfig;
	title?: string;
	description?: string;
	ogImage?: string;
	noindex?: boolean;
}

const { config, title, description, ogImage, noindex = false } = Astro.props;

const pageTitle = title ?? config.seo.title;
const pageDescription = description ?? config.seo.description;
const pageImage = ogImage ?? config.seo.ogImage;
const canonical = new URL(Astro.url.pathname, config.siteUrl).href;
const imageUrl = pageImage ? new URL(pageImage, config.siteUrl).href : "";
const ogLocale = config.locale === "uk" ? "uk_UA" : "en_US";

function cssFont(name: string) {
	return `"${name.replace(/["\\]/g, "")}"`;
}

const themeVars: Array<[string, string]> = [
	["--theme-bg", config.theme.colors.bg],
	["--theme-surface", config.theme.colors.surface],
	["--theme-text", config.theme.colors.text],
	["--theme-muted", config.theme.colors.muted],
	["--theme-primary", config.theme.colors.primary],
	["--theme-primary-contrast", config.theme.colors.primaryContrast],
	["--theme-accent", config.theme.colors.accent],
	["--theme-border", config.theme.colors.border],
	["--theme-font-heading", cssFont(config.theme.fonts.heading)],
	["--theme-font-body", cssFont(config.theme.fonts.body)],
	["--theme-radius", config.theme.radius],
];

const themeCss = `:root {\n${themeVars.map(([name, value]) => `\t${name}: ${value};`).join("\n")}\n}`;

const jsonLd: Record<string, unknown> = {
	"@context": "https://schema.org",
	"@type": config.businessType,
	name: config.name,
	url: canonical,
	...(config.contacts.phone ? { telephone: config.contacts.phone } : {}),
	...(imageUrl ? { image: imageUrl } : {}),
	...(config.priceRange ? { priceRange: config.priceRange } : {}),
};

if (config.contacts.address || config.contacts.city || config.contacts.postalCode) {
	jsonLd.address = {
		"@type": "PostalAddress",
		...(config.contacts.address ? { streetAddress: config.contacts.address } : {}),
		...(config.contacts.postalCode ? { postalCode: config.contacts.postalCode } : {}),
		...(config.contacts.city ? { addressLocality: config.contacts.city } : {}),
		addressCountry: "UA",
	};
}

if (config.contacts.geo) {
	jsonLd.geo = {
		"@type": "GeoCoordinates",
		latitude: config.contacts.geo.lat,
		longitude: config.contacts.geo.lng,
	};
}

if (config.contacts.hoursSchema?.length) {
	jsonLd.openingHoursSpecification = config.contacts.hoursSchema.map((hours) => ({
		"@type": "OpeningHoursSpecification",
		dayOfWeek: hours.dayOfWeek,
		opens: hours.opens,
		closes: hours.closes,
	}));
}

const demoSite = config.portfolio?.enabled === true;

if (config.rating && !demoSite) {
	jsonLd.aggregateRating = {
		"@type": "AggregateRating",
		ratingValue: config.rating.value,
		reviewCount: config.rating.count,
	};
}

const jsonLdText = JSON.stringify(jsonLd, null, 2).replaceAll("<", "\\u003c");

const favicon = config.seo.favicon;
const faviconIcons = typeof favicon === "object" && favicon !== null ? favicon : null;
const faviconHref = typeof favicon === "string" ? favicon : "/favicon.svg";
---

<!doctype html>
<html lang={config.locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={config.theme.colors.primary} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={config.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		{
			imageUrl && (
				<>
					<meta property="og:image" content={imageUrl} />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
					<meta property="og:image:alt" content={pageTitle} />
				</>
			)
		}
		<meta property="og:locale" content={ogLocale} />
		<meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		{imageUrl && <meta name="twitter:image" content={imageUrl} />}
		{(noindex || demoSite) && <meta name="robots" content="noindex, nofollow" />}
		{
			faviconIcons ? (
				<>
					<link rel="icon" type="image/svg+xml" href={faviconIcons.svg} />
					<link rel="icon" type="image/png" sizes="48x48" href={faviconIcons.png} />
					<link rel="apple-touch-icon" sizes="180x180" href={faviconIcons.apple} />
				</>
			) : (
				<link rel="icon" type="image/svg+xml" href={faviconHref} />
			)
		}
		<style is:inline set:html={themeCss}></style>
		<script type="application/ld+json" is:inline set:html={jsonLdText}></script>
	</head>
	<body>
		<slot />
		{config.portfolio.enabled && <DemoModal config={config} />}
	</body>
</html>
