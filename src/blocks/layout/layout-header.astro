---
interface NavItem {
	label: string;
	href: string;
}

interface Props {
	name: string;
	nav: NavItem[];
	ctaLabel: string;
	ctaHref: string;
	nameHref?: string;
	/** Якщо задано, якірні посилання ведуть на головну: /template-lashes/#prices. */
	anchorBase?: string;
	/** Повноекранне мобільне меню. Без цього пропса меню як раніше, випадає під шапкою. */
	overlayMenu?: boolean;
	phone?: { label: string; href: string };
}

const {
	name,
	nav,
	ctaLabel,
	ctaHref,
	nameHref = "#hero",
	anchorBase = "",
	overlayMenu = false,
	phone,
} = Astro.props;

function withBase(href: string) {
	if (!anchorBase || !href.startsWith("#")) return href;
	const base = anchorBase.endsWith("/") ? anchorBase.slice(0, -1) : anchorBase;
	return `${base}/${href}`;
}

const links = nav.map((item) => ({ ...item, href: withBase(item.href) }));
const bookHref = withBase(ctaHref);
const menuId = "layout-header-menu";
---

{
	overlayMenu ? (
		<div data-block="layout-header" class="sticky top-0 z-50">
			<header class="border-b border-border bg-bg/90 backdrop-blur-md">
				<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 xl:px-8">
					{name && (
						<a href={nameHref} class="font-heading text-2xl text-text">
							{name}
						</a>
					)}
					<nav class="hidden items-center gap-x-3 text-sm lg:flex xl:gap-x-5" aria-label="Основна навігація">
						{
							links.map((item) => (
								<a href={item.href} class="text-text hover:text-primary">
									{item.label}
								</a>
							))
						}
					</nav>
					<div class:list={["flex items-center gap-2", !name && "ml-auto"]}>
						<a
							href={bookHref}
							class="hidden min-h-11 w-fit shrink-0 items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast md:inline-flex"
						>
							{ctaLabel}
						</a>
						<button
							type="button"
							data-menu-toggle
							class="inline-flex h-11 w-11 items-center justify-center rounded-theme border border-border text-text lg:hidden"
							aria-expanded="false"
							aria-controls={menuId}
							aria-label="Відкрити меню"
						>
							<svg data-icon-open xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
							</svg>
						</button>
					</div>
				</div>
			</header>
			<div
				id={menuId}
				data-mobile-nav
				data-overlay
				class="fixed inset-0 z-[80] flex flex-col overflow-y-auto bg-bg lg:hidden"
				hidden
			>
				<div class="mx-auto flex w-full max-w-6xl items-center justify-end px-4 py-3 xl:px-8">
					<button
						type="button"
						data-menu-close
						class="inline-flex h-11 w-11 items-center justify-center rounded-theme border border-border text-text"
						aria-label="Закрити"
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
				<nav class="flex flex-col px-4" aria-label="Мобільна навігація">
					{
						links.map((item) => (
							<a href={item.href} class="flex min-h-12 items-center border-b border-border font-body text-lg text-text">
								{item.label}
							</a>
						))
					}
					<a
						href={bookHref}
						class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast"
					>
						{ctaLabel}
					</a>
					{
						phone && (
							<a href={phone.href} class="inline-flex min-h-11 items-center font-body text-base text-primary">
								{phone.label}
							</a>
						)
					}
				</nav>
			</div>
		</div>
	) : (
		<header data-block="layout-header" class="sticky top-0 z-50 border-b border-border bg-bg/90 backdrop-blur-md">
			<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 xl:px-8">
				{name && (
					<a href={nameHref} class="font-heading text-2xl text-text">
						{name}
					</a>
				)}
				<nav class="hidden items-center gap-x-3 text-sm lg:flex xl:gap-x-5" aria-label="Основна навігація">
					{
						links.map((item) => (
							<a href={item.href} class="text-text hover:text-primary">
								{item.label}
							</a>
						))
					}
				</nav>
				<div class:list={["flex items-center gap-2", !name && "ml-auto"]}>
					<a
						href={bookHref}
						class="hidden min-h-11 w-fit shrink-0 items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast md:inline-flex"
					>
						{ctaLabel}
					</a>
					<button
						type="button"
						data-menu-toggle
						class="inline-flex h-11 w-11 items-center justify-center rounded-theme border border-border text-text lg:hidden"
						aria-expanded="false"
						aria-controls={menuId}
						aria-label="Відкрити меню"
					>
						<svg data-icon-open xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
						</svg>
						<svg data-icon-close xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="hidden h-6 w-6" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
			</div>
			<div id={menuId} data-mobile-nav class="hidden border-t border-border bg-bg lg:hidden" hidden>
				<nav class="mx-auto flex max-w-6xl flex-col px-4 py-2 xl:px-8" aria-label="Мобільна навігація">
					{
						links.map((item) => (
							<a href={item.href} class="flex min-h-11 items-center text-text">
								{item.label}
							</a>
						))
					}
					<a
						href={bookHref}
						class="mt-2 inline-flex min-h-11 items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast"
					>
						{ctaLabel}
					</a>
				</nav>
			</div>
		</header>
	)
}

<script>
	const headers = () => document.querySelectorAll("[data-block='layout-header']");

	function setOpen(header, open) {
		const toggle = header.querySelector("[data-menu-toggle]");
		const panel = header.querySelector("[data-mobile-nav]");
		const iconOpen = header.querySelector("[data-icon-open]");
		const iconClose = header.querySelector("[data-icon-close]");
		if (!toggle || !panel) return;

		const wasOpen = toggle.getAttribute("aria-expanded") === "true";
		const overlay = panel.hasAttribute("data-overlay");
		toggle.setAttribute("aria-expanded", open ? "true" : "false");
		toggle.setAttribute("aria-label", open ? "Закрити меню" : "Відкрити меню");
		panel.classList.toggle("hidden", !open);
		if (open) panel.removeAttribute("hidden");
		else panel.setAttribute("hidden", "");
		iconOpen?.classList.toggle("hidden", open);
		iconClose?.classList.toggle("hidden", !open);
		if (overlay) document.body.style.overflow = open ? "hidden" : "";
		if (!open && wasOpen && overlay) window.setTimeout(() => toggle.focus(), 0);
	}

	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const toggle = target.closest("[data-menu-toggle]");
		if (toggle) {
			const header = toggle.closest("[data-block='layout-header']");
			if (!header) return;
			const open = toggle.getAttribute("aria-expanded") === "true";
			setOpen(header, !open);
			return;
		}

		const close = target.closest("[data-menu-close]");
		if (close) {
			const header = close.closest("[data-block='layout-header']");
			if (header) setOpen(header, false);
			return;
		}

		const link = target.closest("[data-mobile-nav] a");
		if (link) {
			const header = link.closest("[data-block='layout-header']");
			if (header) setOpen(header, false);
		}
	});

	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape") return;
		headers().forEach((header) => setOpen(header, false));
	});
</script>

<style is:global>
	[data-block="layout-header"] [data-overlay][hidden] {
		display: none !important;
	}
</style>
