---
import type { SiteConfig } from "../../config/types";
import { typograf } from "../../lib/typograf";

interface Props {
	title: string;
	directions: string;
	contacts: SiteConfig["contacts"];
}

const { title, directions, contacts } = Astro.props;

const mapSrc = contacts.geo
	? `https://maps.google.com/maps?q=${contacts.geo.lat},${contacts.geo.lng}&z=16&output=embed`
	: "";

function handle(value: string) {
	return value.replace(/^@/, "");
}

function viberHref(phone: string) {
	const digits = phone.replace(/\D/g, "");
	return `viber://chat?number=%2B${digits}`;
}

const messengers = [
	contacts.telegram
		? { id: "telegram", label: "Telegram", href: `https://t.me/${handle(contacts.telegram)}` }
		: null,
	contacts.viber ? { id: "viber", label: "Viber", href: viberHref(contacts.viber) } : null,
	contacts.instagram
		? { id: "instagram", label: "Instagram", href: `https://instagram.com/${handle(contacts.instagram)}` }
		: null,
].filter((item) => item !== null);
---

<section id="contacts" data-block="contacts-map">
	<div class="mx-auto grid max-w-6xl items-start gap-8 px-4 py-12 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:items-stretch md:gap-10 xl:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] xl:items-start xl:gap-8 xl:px-8">
		<div>
			<h2 class="text-3xl">{typograf(title)}</h2>
			<dl class="mt-6 space-y-4">
				{
					(contacts.address || contacts.city) && (
						<div>
							<dt class="font-body text-sm text-muted">Адреса</dt>
							<dd class="mt-1 font-body text-[15px] leading-[1.5]">
								{contacts.address && <span class="block">{contacts.address}</span>}
								{contacts.city && <span class="block">{contacts.city}</span>}
							</dd>
						</div>
					)
				}
				{
					contacts.hours && (
						<div>
							<dt class="font-body text-sm text-muted">Графік</dt>
							<dd class="mt-1 font-body text-[15px] leading-[1.5]">{contacts.hours}</dd>
						</div>
					)
				}
				<div>
					<dt class="font-body text-sm text-muted">Як дістатися</dt>
					<dd class="mt-1 font-body text-[15px] leading-[1.5]">{directions}</dd>
				</div>
				<div>
					<dt class="font-body text-sm text-muted">Телефон</dt>
					<dd class="mt-1">
						<a href={`tel:${contacts.phone}`} class="inline-flex min-h-11 items-center font-body text-[15px] text-primary">
							{contacts.phoneDisplay ?? contacts.phone}
						</a>
					</dd>
				</div>
			</dl>
			{
				messengers.length > 0 && (
					<ul class="mt-2 flex list-none flex-wrap gap-2 p-0">
						{messengers.map((item) => (
							<li>
								<a
									href={item.href}
									data-messenger={item.id}
									aria-label={item.label}
									class="inline-flex min-h-11 items-center gap-2 rounded-theme border border-border px-4 text-[15px]"
								>
									{item.id === "telegram" && (
										<svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
											<path d="M21.2 4.4 2.9 11.2c-.9.3-.9.9-.2 1.1l4.7 1.5 10.8-6.8c.5-.3 1-.1.6.2l-8.7 7.9-.3 4.6c.5 0 .7-.2 1-.5l2.4-2.3 5 3.7c.9.5 1.6.2 1.8-.9l3.3-15.4c.3-1.3-.5-1.9-1.5-1.5Z" />
										</svg>
									)}
									{item.id === "viber" && (
										<svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
											<path d="M12.2 3C7.6 3 4.2 6.2 4 10.6c-.1 2.3.7 4.3 2.2 5.8l-.7 3.2c-.1.5.4.9.8.6l3.3-1.8c.8.3 1.7.4 2.6.4 4.7 0 8.1-3.3 8.3-7.8C20.7 6.3 17.2 3 12.2 3Zm4.6 9.4c-.2.5-1.1 1-1.5 1.1-.4.1-.8.2-2.4-.5-2-.9-3.3-3-3.4-3.1-.1-.2-.9-1.2-.9-2.3s.6-1.6.8-1.8c.2-.2.4-.3.6-.3h.4c.1 0 .3 0 .5.4.2.5.6 1.6.7 1.7.1.1.1.3 0 .5-.1.2-.2.3-.3.5l-.2.3c-.1.1-.2.2-.1.4.2.3.7 1.1 1.5 1.8.9.8 1.7 1 2 .9.2-.1.4-.2.6-.4.1-.2.3-.1.5-.1l1.4.7c.2.1.4.2.4.3.1.2 0 .8-.2 1.1Z" />
										</svg>
									)}
									{item.id === "instagram" && (
										<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
											<rect x="4" y="4" width="16" height="16" rx="4" />
											<circle cx="12" cy="12" r="3.5" />
											<circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none" />
										</svg>
									)}
									{item.label}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
		{
			mapSrc && (
				<div class="overflow-hidden rounded-theme md:h-full md:min-h-[320px] xl:h-auto xl:min-h-0">
					<iframe
						src={mapSrc}
						loading="lazy"
						title="Карта: як нас знайти"
						class="h-72 w-full border-0 md:h-full md:min-h-[320px] xl:h-[400px] xl:min-h-0"
						referrerpolicy="no-referrer-when-downgrade"
					/>
				</div>
			)
		}
	</div>
</section>
