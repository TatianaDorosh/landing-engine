---
import type { Locale, SiteConfig } from "../../config/types";
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

interface Props {
	title: string;
	text: string;
	serviceName: string;
	url: string;
	phone: string;
	lead?: string;
	points?: string[];
	note?: string;
	contacts?: SiteConfig["contacts"];
	locale?: Locale;
}

const { title, text, serviceName, url, phone, lead, points, note, contacts, locale = "uk" } = Astro.props;
const ui = getUi(locale);
const intro = lead || text;
const list = (points ?? []).slice(0, 4).filter((point) => point.trim() !== "");
const serviceLabel = serviceName.trim();
const showService = serviceLabel !== "" && serviceLabel !== "[ЗАПОВНИТИ]" && serviceLabel !== "ЗАПОВНИТИ";
const realUrl = /^https?:\/\//.test(url);
const tel = `tel:${phone.replace(/[^\d+]/g, "")}`;

function handle(value: string) {
	return value.replace(/^@/, "");
}

const messengers = [
	contacts?.telegram
		? { id: "telegram" as const, href: `https://t.me/${handle(contacts.telegram)}` }
		: null,
	contacts?.instagram
		? { id: "instagram" as const, href: `https://instagram.com/${handle(contacts.instagram)}` }
		: null,
].filter((item) => item !== null);
---

<section id="booking" data-block="booking-online-service" class="scroll-mt-24">
	<div class="mx-auto grid max-w-6xl min-w-0 items-start gap-8 px-4 py-12 md:grid-cols-12 md:gap-x-10 xl:px-8">
		<div class="min-w-0 md:col-span-7">
			<h2 class="text-3xl">{typograf(title)}</h2>
			{intro && <p class="mt-3 font-body text-base leading-relaxed text-muted">{typograf(intro)}</p>}
			{
				list.length > 0 && (
					<ul class="mt-6 flex list-none flex-col gap-3 p-0">
						{list.map((point) => (
							<li class="flex items-start gap-3">
								<svg
									class="mt-0.5 h-5 w-5 shrink-0 text-primary"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									aria-hidden="true"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
									/>
								</svg>
								<span class="min-w-0 font-body text-[15px] leading-snug">{typograf(point)}</span>
							</li>
						))}
					</ul>
				)
			}
		</div>
		<div class="min-w-0 md:col-span-5">
			<div class="rounded-theme border border-border bg-surface p-6">
				<a
					href={realUrl ? url : "#"}
					data-demo-booking
					class="inline-flex min-h-14 w-full items-center justify-center rounded-theme bg-primary px-6 text-center font-body text-lg text-primary-contrast"
					{...(realUrl ? { target: "_blank", rel: "noopener" } : {})}
				>
					{ui.booking.online}
				</a>
				{
					showService && (
						<p class="mt-3 text-center font-body text-sm text-muted">
							{ui.booking.via.replace("{name}", serviceLabel)}
						</p>
					)
				}
				{note && <p class="mt-2 text-center font-body text-sm text-muted">{typograf(note)}</p>}
				<div class="mt-6 flex items-center gap-3">
					<span class="h-px min-w-0 flex-1 bg-border" aria-hidden="true"></span>
					<span class="font-body text-sm text-muted">{ui.booking.or}</span>
					<span class="h-px min-w-0 flex-1 bg-border" aria-hidden="true"></span>
				</div>
				<div class="mt-4 flex flex-wrap items-center justify-center gap-x-5 gap-y-1">
					<a href={tel} class="inline-flex min-h-11 items-center font-body text-[15px] text-primary">{phone}</a>
					{
						messengers.map((item) => (
							<a
								href={item.href}
								data-messenger={item.id}
								class="inline-flex min-h-11 items-center font-body text-[15px] text-primary"
							>
								{ui.messengers[item.id]}
							</a>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
