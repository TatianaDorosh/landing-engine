---
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { typograf } from "../../lib/typograf";

interface GalleryItem {
	category: string;
	label: string;
	image?: { src: string; alt: string; width: number; height: number };
}

interface Props {
	title: string;
	categories: string[];
	items: GalleryItem[];
	/** Якір секції. За замовчуванням gallery, щоб не змінити наявні сторінки. */
	sectionId?: string;
	/** Менший верхній відступ, щоб блок починався вище на першому екрані. */
	spacing?: "regular" | "tight";
	/** pill — кнопки-таблетки, underline — текстові вкладки з лінією. */
	tabsStyle?: "pill" | "underline";
	/** grid — сітка на комп'ютері, carousel — горизонтальна доріжка на всіх ширинах. */
	layout?: "grid" | "carousel";
}

const { title, categories, items, sectionId = "gallery", spacing = "regular", tabsStyle = "pill", layout = "grid" } = Astro.props;
const first = categories[0] ?? "";
const tight = spacing === "tight";
const underline = tabsStyle === "underline";
const carousel = layout === "carousel";
---

<section id={sectionId} data-block="gallery-carousel" data-layout={layout}>
	<div class:list={["mx-auto max-w-6xl px-4 xl:px-8", tight ? "pt-4 pb-12" : "py-12"]}>
		<h2 class="text-3xl">{typograf(title)}</h2>
		<div class:list={[carousel && ["flex items-center gap-4", tight ? "mt-3" : "mt-6"]]}>
		<div
			data-tabs-style={tabsStyle}
			role={underline ? "tablist" : undefined}
			aria-label={underline ? "Категорії" : undefined}
			class:list={[
				carousel ? "min-w-0 flex-1" : tight ? "mt-3" : "mt-6",
				underline
					? "flex flex-nowrap items-stretch gap-8 border-b border-border"
					: "flex flex-wrap gap-2",
			]}
		>
			{
				categories.map((category) => {
					const active = category === first;
					return underline ? (
						<button
							type="button"
							role="tab"
							data-category-tab={category}
							aria-selected={active ? "true" : "false"}
							tabindex={active ? 0 : -1}
							class:list={[
								"relative inline-flex min-h-11 items-center rounded-none border-0 bg-transparent px-0 font-body text-base",
								active ? "font-semibold text-primary" : "font-normal text-muted hover:text-text",
							]}
						>
							{category}
							<span
								data-tab-line
								class:list={[
									"pointer-events-none absolute inset-x-0 -bottom-px z-10 h-[3px]",
									active ? "bg-primary" : "bg-transparent",
								]}
								aria-hidden="true"
							/>
						</button>
					) : (
						<button
							type="button"
							data-category-tab={category}
							aria-pressed={active ? "true" : "false"}
							class:list={[
								"inline-flex min-h-11 items-center rounded-theme px-4",
								active ? "bg-primary text-primary-contrast" : "border border-border text-text",
							]}
						>
							{category}
						</button>
					);
				})
			}
		</div>
		{
			carousel && (
				<div class="hidden shrink-0 gap-2 sm:flex">
					<button
						type="button"
						data-carousel-prev
						class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-transparent text-text disabled:opacity-40"
						aria-label="Попередні роботи"
						disabled
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
						</svg>
					</button>
					<button
						type="button"
						data-carousel-next
						class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-transparent text-text disabled:opacity-40"
						aria-label="Наступні роботи"
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
						</svg>
					</button>
				</div>
			)
		}
		</div>

		<div
			data-track
			data-layout={layout}
			tabindex="0"
			role="region"
			aria-label={carousel ? "Роботи" : "Фото галереї"}
			class:list={[
				"flex gap-3 overflow-x-auto",
				carousel
					? "min-w-0 max-w-full snap-x snap-mandatory overscroll-x-contain"
					: "snap-x snap-mandatory xl:grid xl:grid-cols-3 xl:overflow-visible",
				tight ? "mt-3" : "mt-6",
			]}
		>
			{
				items.map((item) => {
					const visible = item.category === first;
					return (
						<button
							type="button"
							data-slide
							data-category={item.category}
							data-label={item.label}
							data-src={item.image?.src ?? ""}
							data-alt={item.image?.alt ?? item.label}
							hidden={!visible}
							class:list={[
								"shrink-0 overflow-hidden rounded-theme border border-border text-left",
								carousel
									? "snap-start"
									: "w-[85%] snap-center xl:w-auto",
								!visible && "hidden",
							]}
						>
							{item.image ? (
								<img
									src={item.image.src}
									alt={item.image.alt}
									width={item.image.width}
									height={item.image.height}
									loading="lazy"
									decoding="async"
									class:list={["w-full object-cover", carousel ? "aspect-[4/5] lg:aspect-square" : "aspect-square"]}
								/>
							) : (
								<PhotoPlaceholder
									label={item.label}
									class={carousel ? "aspect-[4/5] lg:aspect-square" : "aspect-square"}
								/>
							)}
						</button>
					);
				})
			}
		</div>
		<div data-dots class:list={[carousel ? "hidden" : "mt-2 flex justify-center xl:hidden"]} aria-label="Фото галереї"></div>
	</div>

	<style>
		[data-track][data-layout="carousel"] {
			scrollbar-width: none;
		}
		[data-track][data-layout="carousel"]::-webkit-scrollbar {
			display: none;
		}
		[data-track][data-layout="carousel"]:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
		}
		[data-track][data-layout="carousel"] [data-slide] {
			width: 84%;
		}
		@media (min-width: 640px) {
			[data-track][data-layout="carousel"] [data-slide] {
				width: calc((100% - 1.5rem) / 2.12);
			}
		}
		@media (min-width: 1024px) {
			[data-track][data-layout="carousel"] [data-slide] {
				width: calc((100% - 2.25rem) / 3.12);
			}
		}
	</style>

	<div
		data-lightbox
		class="fixed inset-0 z-[80] hidden items-center justify-center bg-text/80 p-4"
		role="dialog"
		aria-modal="true"
		aria-label="Перегляд фото"
		hidden
	>
		<button
			type="button"
			data-lightbox-close
			class="absolute right-4 top-4 inline-flex min-h-11 min-w-11 items-center justify-center rounded-theme bg-surface text-text"
			aria-label="Закрити"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
			</svg>
		</button>
		<button
			type="button"
			data-lightbox-prev
			class="absolute left-3 inline-flex min-h-11 min-w-11 items-center justify-center rounded-theme bg-surface text-text"
			aria-label="Попереднє фото"
		>
			‹
		</button>
		<div class="w-full max-w-3xl">
			<img data-lightbox-image alt="" class="hidden max-h-[80vh] w-full object-contain" />
			<div
				data-lightbox-placeholder
				class="flex aspect-square w-full items-center justify-center bg-border px-6 text-center text-muted"
			>
			</div>
		</div>
		<button
			type="button"
			data-lightbox-next
			class="absolute right-3 inline-flex min-h-11 min-w-11 items-center justify-center rounded-theme bg-surface text-text"
			aria-label="Наступне фото"
		>
			›
		</button>
	</div>
</section>

<script>
	document.querySelectorAll("[data-block='gallery-carousel']").forEach((root) => {
		const track = root.querySelector("[data-track]");
		const dots = root.querySelector("[data-dots]");
		const dialog = root.querySelector("[data-lightbox]");
		const closeBtn = root.querySelector("[data-lightbox-close]");
		const image = root.querySelector("[data-lightbox-image]");
		const placeholder = root.querySelector("[data-lightbox-placeholder]");
		if (!track || !dots || !dialog || !closeBtn || !(image instanceof HTMLImageElement) || !placeholder) return;

		const tabs = [...root.querySelectorAll("[data-category-tab]")];
		const underline = root.querySelector("[data-tabs-style]")?.getAttribute("data-tabs-style") === "underline";
		const carousel = root.getAttribute("data-layout") === "carousel";
		const prevBtn = root.querySelector("[data-carousel-prev]");
		const nextBtn = root.querySelector("[data-carousel-next]");
		let index = 0;
		let lastTrigger = null;

		const slides = () => [...root.querySelectorAll("[data-slide]")];
		const visibleSlides = () => slides().filter((slide) => !slide.hasAttribute("hidden"));

		function setPressed(category) {
			tabs.forEach((tab) => {
				const on = tab.getAttribute("data-category-tab") === category;
				if (underline) {
					tab.setAttribute("aria-selected", on ? "true" : "false");
					tab.tabIndex = on ? 0 : -1;
					tab.classList.toggle("font-semibold", on);
					tab.classList.toggle("text-primary", on);
					tab.classList.toggle("font-normal", !on);
					tab.classList.toggle("text-muted", !on);
					tab.classList.toggle("hover:text-text", !on);
					const line = tab.querySelector("[data-tab-line]");
					line?.classList.toggle("bg-primary", on);
					line?.classList.toggle("bg-transparent", !on);
					return;
				}
				tab.setAttribute("aria-pressed", on ? "true" : "false");
				tab.classList.toggle("bg-primary", on);
				tab.classList.toggle("text-primary-contrast", on);
				tab.classList.toggle("border", !on);
				tab.classList.toggle("border-border", !on);
				tab.classList.toggle("text-text", !on);
			});
		}

		function rebuildDots() {
			const count = visibleSlides().length;
			dots.replaceChildren();
			for (let i = 0; i < count; i += 1) {
				const dot = document.createElement("button");
				dot.type = "button";
				dot.dataset.dot = String(i);
				dot.className = "inline-flex min-h-11 min-w-11 items-center justify-center";
				dot.setAttribute("aria-label", `Фото ${i + 1}`);
				const mark = document.createElement("span");
				mark.className = "h-2.5 w-2.5 rounded-full bg-border";
				dot.append(mark);
				dots.append(dot);
			}
			setActiveDot(0);
		}

		function setActiveDot(active) {
			[...dots.querySelectorAll("[data-dot]")].forEach((dot, i) => {
				const mark = dot.querySelector("span");
				const on = i === active;
				dot.setAttribute("aria-current", on ? "true" : "false");
				mark?.classList.toggle("bg-primary", on);
				mark?.classList.toggle("bg-border", !on);
			});
		}

		function applyFilter(category) {
			slides().forEach((slide) => {
				const show = slide.getAttribute("data-category") === category;
				slide.toggleAttribute("hidden", !show);
				slide.classList.toggle("hidden", !show);
			});
			setPressed(category);
			rebuildDots();
			scrollTarget = null;
			track.scrollTo({ left: 0 });
			if (carousel) requestAnimationFrame(updateArrows);
		}

		let scrollTarget = null;

		function scrollStep(direction) {
			const slide = visibleSlides()[0];
			if (!(track instanceof HTMLElement) || !(slide instanceof HTMLElement)) return;
			const gap = parseFloat(getComputedStyle(track).columnGap) || 12;
			const step = slide.getBoundingClientRect().width + gap;
			const max = Math.max(0, track.scrollWidth - track.clientWidth);
			const base = scrollTarget ?? track.scrollLeft;
			const next = Math.max(0, Math.min(max, base + direction * step));
			scrollTarget = next;
			track.scrollTo({ left: next, behavior: "auto" });
			updateArrows();
		}

		function updateArrows() {
			if (!(track instanceof HTMLElement)) return;
			if (!(prevBtn instanceof HTMLButtonElement) || !(nextBtn instanceof HTMLButtonElement)) return;
			const max = Math.max(0, track.scrollWidth - track.clientWidth);
			const left = scrollTarget ?? track.scrollLeft;
			if (scrollTarget !== null && Math.abs(track.scrollLeft - scrollTarget) <= 2) scrollTarget = null;
			prevBtn.disabled = left <= 2;
			nextBtn.disabled = max <= 2 || left >= max - 2;
		}

		function renderLightbox() {
			const list = visibleSlides();
			if (!list.length) return;
			index = (index + list.length) % list.length;
			const slide = list[index];
			const src = slide.getAttribute("data-src") || "";
			const label = slide.getAttribute("data-label") || "";
			const alt = slide.getAttribute("data-alt") || label;
			if (src) {
				image.hidden = false;
				image.src = src;
				image.alt = alt;
				placeholder.hidden = true;
			} else {
				image.hidden = true;
				image.removeAttribute("src");
				placeholder.hidden = false;
				placeholder.textContent = label;
			}
		}

		function openLightbox(nextIndex, trigger) {
			index = nextIndex;
			lastTrigger = trigger;
			renderLightbox();
			dialog.hidden = false;
			dialog.classList.remove("hidden");
			dialog.classList.add("flex");
			document.body.style.overflow = "hidden";
			if (closeBtn instanceof HTMLElement) closeBtn.focus();
		}

		function closeLightbox() {
			dialog.hidden = true;
			dialog.classList.add("hidden");
			dialog.classList.remove("flex");
			document.body.style.overflow = "";
			if (lastTrigger instanceof HTMLElement) lastTrigger.focus();
		}

		tabs.forEach((tab) => {
			tab.addEventListener("click", () => {
				const category = tab.getAttribute("data-category-tab");
				if (category) applyFilter(category);
			});
		});

		if (underline) {
			const tabList = root.querySelector("[role='tablist']");
			tabList?.addEventListener("keydown", (event) => {
				if (!(event instanceof KeyboardEvent)) return;
				if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
				const current = tabs.indexOf(document.activeElement);
				if (current < 0) return;
				event.preventDefault();
				const next =
					event.key === "ArrowRight"
						? (current + 1) % tabs.length
						: (current - 1 + tabs.length) % tabs.length;
				const category = tabs[next].getAttribute("data-category-tab");
				if (category) applyFilter(category);
				tabs[next].focus();
			});
		}

		track.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const slide = target.closest("[data-slide]");
			if (!slide || slide.hasAttribute("hidden")) return;
			const list = visibleSlides();
			openLightbox(list.indexOf(slide), slide);
		});

		dots.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const dot = target.closest("[data-dot]");
			if (!dot) return;
			const slide = visibleSlides()[Number(dot.getAttribute("data-dot"))];
			slide?.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
		});

		if (carousel && prevBtn instanceof HTMLButtonElement && nextBtn instanceof HTMLButtonElement) {
			prevBtn.addEventListener("click", () => scrollStep(-1));
			nextBtn.addEventListener("click", () => scrollStep(1));
			track.addEventListener("scroll", updateArrows, { passive: true });
			window.addEventListener("resize", updateArrows);
			track.addEventListener("keydown", (event) => {
				if (!(event instanceof KeyboardEvent)) return;
				if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
				event.preventDefault();
				scrollStep(event.key === "ArrowRight" ? 1 : -1);
			});
			updateArrows();
		}

		if (!carousel && "IntersectionObserver" in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					if (window.matchMedia("(min-width: 1280px)").matches) return;
					const visible = entries
						.filter((entry) => entry.isIntersecting && !entry.target.hasAttribute("hidden"))
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
					if (!visible) return;
					setActiveDot(visibleSlides().indexOf(visible.target));
				},
				{ root: track, threshold: [0.55, 0.75] },
			);
			slides().forEach((slide) => observer.observe(slide));
		}

		closeBtn.addEventListener("click", closeLightbox);
		root.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => {
			index -= 1;
			renderLightbox();
		});
		root.querySelector("[data-lightbox-next]")?.addEventListener("click", () => {
			index += 1;
			renderLightbox();
		});
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) closeLightbox();
		});
		document.addEventListener("keydown", (event) => {
			if (dialog.hasAttribute("hidden")) return;
			if (event.key === "Escape") {
				closeLightbox();
				return;
			}
			if (event.key === "ArrowRight") {
				event.preventDefault();
				index += 1;
				renderLightbox();
			}
			if (event.key === "ArrowLeft") {
				event.preventDefault();
				index -= 1;
				renderLightbox();
			}
		});

		rebuildDots();
	});
</script>
