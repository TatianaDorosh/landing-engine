---
interface Props {
	label: string;
	/** Якщо задано — доступна назва. Без нього розмітка як раніше. */
	alt?: string;
	ratio?: string;
	class?: string;
	tone?: "border" | "primary";
}

const { label, alt = "", ratio = "4/3", class: className, tone = "border" } = Astro.props;
const safeRatio = /^\d+\/\d+$/.test(ratio) ? ratio : "4/3";
---

<div
	class:list={[
		"flex w-full items-center justify-center px-4 text-center text-sm",
		tone === "primary" ? "bg-primary text-primary-contrast" : "bg-border text-muted",
		className,
	]}
	style={className?.includes("aspect-") || className?.includes("h-full") ? undefined : `aspect-ratio: ${safeRatio}`}
	aria-label={alt || undefined}
>
	{label}
</div>
