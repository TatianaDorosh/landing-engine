---
// Шаблон для демо. Для реального клієнта перевірити й адаптувати текст
import type { SiteConfig } from "../config/types";
import { typograf } from "../lib/typograf";

interface Props {
	config: SiteConfig;
}

const { config } = Astro.props;
const { name, contacts } = config;
const phone = contacts.phoneDisplay ?? contacts.phone;
---

<article class="mx-auto max-w-[720px] px-4 py-12 font-body text-base leading-relaxed xl:px-8">
	<h1 class="text-3xl">{typograf("Політика приватності")}</h1>
	<p class="mt-4">
		Цей текст пояснює, які дані збирає студія і навіщо вони потрібні.
	</p>

	<h2 class="mt-8 text-2xl">{typograf("Хто збирає дані")}</h2>
	<p class="mt-3">
		Дані збирає {name}.
		{contacts.address && <> Адреса: {contacts.address}{contacts.city ? `, ${contacts.city}` : ""}.</>}
		{" "}Телефон: <a href={`tel:${contacts.phone}`} class="text-primary">{phone}</a>.
	</p>

	<h2 class="mt-8 text-2xl">{typograf("Які дані")}</h2>
	<p class="mt-3">
		Ім'я, телефон, послуга, дата і час, коментар і спосіб зв'язку.
	</p>

	<h2 class="mt-8 text-2xl">{typograf("Навіщо")}</h2>
	<p class="mt-3">Лише для запису і зв'язку щодо візиту.</p>

	<h2 class="mt-8 text-2xl">{typograf("Як передаються")}</h2>
	<p class="mt-3">
		Заявка з форми надходить на пошту студії через сервіс Web3Forms.
	</p>

	<h2 class="mt-8 text-2xl">{typograf("Скільки зберігаються")}</h2>
	<p class="mt-3">12 місяців, потім видаляються.</p>

	<h2 class="mt-8 text-2xl">{typograf("Ваші права")}</h2>
	<p class="mt-3">
		Ви можете дізнатися, виправити або видалити свої дані. Для цього напишіть на контакти студії.
	</p>

	<h2 class="mt-8 text-2xl">{typograf("Дата оновлення")}</h2>
	<p class="mt-3">4 жовтня 2026</p>
</article>
