---
interface Item {
	value: string;
	label: string;
}

interface Props {
	items: Item[];
	/** roomy — більші відступи зверху й знизу. Без пропса вигляд як раніше. */
	spacing?: "roomy";
	/** До 640px один стовпець і заголовок 20px. Від 641px вигляд як раніше. */
	mobileStack?: boolean;
}

const { items, spacing, mobileStack = false } = Astro.props;
const three = items.length === 3;
const roomy = spacing === "roomy";
---

<section id="trust" data-block="trust-strip" data-spacing={roomy ? "roomy" : undefined}>
	<div
		class:list={[
			"mx-auto max-w-6xl px-4 xl:px-8",
			roomy ? "py-10 md:py-14" : ["py-10", three && "max-md:pb-0"],
		]}
	>
		<ul
			class:list={[
				"grid list-none p-0",
				three
					? "grid-cols-3 gap-6 max-md:gap-x-2"
					: mobileStack
						? "grid-cols-1 gap-6 min-[641px]:grid-cols-2 xl:grid-cols-4"
						: "grid-cols-2 gap-6 xl:grid-cols-4",
			]}
		>
			{
				items.map((item) => (
					<li class="min-w-0">
						<p
							class:list={[
								"font-heading text-3xl text-primary",
								three && "max-md:text-[20px] max-md:leading-none max-md:whitespace-nowrap",
								mobileStack && "max-[641px]:text-[20px] max-[641px]:leading-snug max-[641px]:break-words",
							]}
						>
							{item.value}
						</p>
						<p class:list={["mt-1 text-sm text-muted", mobileStack && "max-[641px]:text-[15px] max-[641px]:leading-[1.5]"]}>
							{item.label}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
