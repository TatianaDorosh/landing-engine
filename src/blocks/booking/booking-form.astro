---
import BookingFormCore from "../../components/BookingFormCore.astro";
import type { SiteConfig } from "../../config/types";
import { typograf } from "../../lib/typograf";

interface ServiceGroup {
	group: string;
	items: string[];
}

interface Props {
	title: string;
	text: string;
	services: ServiceGroup[];
	masters: string[];
	privacyHref: string;
	config: SiteConfig;
	steps?: string[];
	messengersTitle?: string;
}

const { title, text, services, masters, privacyHref, config, steps = [], messengersTitle = "" } = Astro.props;
const telegramHandle = config.contacts.telegram?.replace(/^@/, "") ?? "";
const viberNumber = config.contacts.viber?.replace(/\D/g, "") ?? "";
---

<section id="booking" data-block="booking-form" class="scroll-mt-24">
	<div class="mx-auto grid max-w-6xl items-start gap-8 px-4 py-12 lg:grid-cols-12 xl:px-8">
		<div class="contents lg:sticky lg:top-[85px] lg:col-span-6 lg:block lg:self-start">
			<div class="order-1 min-w-0">
				<h2 class="text-3xl">{typograf(title)}</h2>
				<p class="mt-4 font-body text-[15px] leading-[1.6] text-muted xl:text-base">{text}</p>
			</div>
			<div class="order-3 min-w-0 lg:mt-8">
				{
					steps.length > 0 && (
						<div>
							<h3 class="font-body text-[17px] font-semibold">{typograf("Як це працює")}</h3>
							<ol class="mt-4 flex list-none flex-col gap-3 p-0">
								{steps.map((step, index) => (
									<li class="flex items-start gap-3">
										<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-primary font-body text-[15px] font-semibold text-primary">
											{index + 1}
										</span>
										<p class="font-body text-[15px] leading-[1.5] text-text">{step}</p>
									</li>
								))}
							</ol>
						</div>
					)
				}
				{
					(telegramHandle || viberNumber) && (
						<div class="mt-6">
							{messengersTitle && <p class="font-body text-[15px] font-semibold">{messengersTitle}</p>}
							<div class="mt-3 flex flex-wrap gap-2">
								{telegramHandle && (
									<a
										href={`https://t.me/${telegramHandle}`}
										data-messenger="telegram"
										class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border px-4 font-body text-[15px] text-text"
									>
										<svg viewBox="0 0 24 24" class="h-5 w-5 text-primary" fill="currentColor" aria-hidden="true">
											<path d="M21.2 4.4 2.9 11.2c-.9.3-.9.9-.2 1.1l4.7 1.5 10.8-6.8c.5-.3 1-.1.6.2l-8.7 7.9-.3 4.6c.5 0 .7-.2 1-.5l2.4-2.3 5 3.7c.9.5 1.6.2 1.8-.9l3.3-15.4c.3-1.3-.5-1.9-1.5-1.5Z" />
										</svg>
										Telegram
									</a>
								)}
								{viberNumber && (
									<a
										href={`viber://chat?number=%2B${viberNumber}`}
										data-messenger="viber"
										class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border px-4 font-body text-[15px] text-text"
									>
										<svg viewBox="0 0 24 24" class="h-5 w-5 text-primary" fill="currentColor" aria-hidden="true">
											<path d="M12.2 3C7.6 3 4.2 6.2 4 10.6c-.1 2.3.7 4.3 2.2 5.8l-.7 3.2c-.1.5.4.9.8.6l3.3-1.8c.8.3 1.7.4 2.6.4 4.7 0 8.1-3.3 8.3-7.8C20.7 6.3 17.2 3 12.2 3Zm4.6 9.4c-.2.5-1.1 1-1.5 1.1-.4.1-.8.2-2.4-.5-2-.9-3.3-3-3.4-3.1-.1-.2-.9-1.2-.9-2.3s.6-1.6.8-1.8c.2-.2.4-.3.6-.3h.4c.1 0 .3 0 .5.4.2.5.6 1.6.7 1.7.1.1.1.3 0 .5-.1.2-.2.3-.3.5l-.2.3c-.1.1-.2.2-.1.4.2.3.7 1.1 1.5 1.8.9.8 1.7 1 2 .9.2-.1.4-.2.6-.4.1-.2.3-.1.5-.1l1.4.7c.2.1.4.2.4.3.1.2 0 .8-.2 1.1Z" />
										</svg>
										Viber
									</a>
								)}
							</div>
						</div>
					)
				}
				{config.contacts.hours && <p class="mt-4 font-body text-[15px] leading-[1.5] text-muted">{config.contacts.hours}</p>}
			</div>
		</div>
		<div class="order-2 min-w-0 rounded-theme border border-border bg-surface p-6 lg:col-span-6">
			<BookingFormCore services={services} masters={masters} privacyHref={privacyHref} config={config} />
		</div>
	</div>
</section>
