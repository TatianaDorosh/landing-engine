---
import Base from "../../layouts/Base.astro";
import Header from "../../blocks/layout/layout-header.astro";
import Footer from "../../blocks/layout/layout-footer.astro";
import PrivacyPolicy from "../../components/PrivacyPolicy.astro";
import { demoLavender } from "../../config/demo-lavender";
import { header } from "../../data/demo-lavender";
---

<Base config={demoLavender} noindex={true} title="Політика приватності — Lavo Nails">
	<Header {...header} nameHref="/template-nails/" anchorBase="/template-nails/" />
	<main>
		<PrivacyPolicy config={demoLavender} />
	</main>
	<Footer config={demoLavender} privacyHref="/template-nails/privacy/" />
</Base>
