---
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { typograf } from "../../lib/typograf";

interface Props {
	eyebrow: string;
	title: string;
	text: string;
	primaryCta: { label: string; href: string };
	secondaryCta: { label: string; href: string };
	image?: { src: string; alt: string };
	imageLabel: string;
}

const { eyebrow, title, text, primaryCta, secondaryCta, image, imageLabel } = Astro.props;
---

<section id="hero" data-block="hero-result">
	<div class="mx-auto grid max-w-6xl items-center gap-6 px-4 py-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-stretch lg:gap-x-10 lg:gap-y-6 lg:px-8 lg:py-12">
		<div class="order-1 lg:col-start-1 lg:row-start-1">
			<p class="text-sm text-muted">{eyebrow}</p>
			<h1 class="mt-3 font-heading text-[36px] leading-[1.15] lg:text-[56px]">{typograf(title)}</h1>
			<p class="mt-4 max-w-xl font-body text-base leading-relaxed">{text}</p>
		</div>
		<div class="order-3 flex flex-col gap-3 lg:col-start-1 lg:row-start-2 lg:flex-row">
			<a
				href={primaryCta.href}
				class="inline-flex min-h-11 w-full items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast lg:w-auto"
			>
				{primaryCta.label}
			</a>
			<a
				href={secondaryCta.href}
				class="inline-flex min-h-11 w-full items-center justify-center rounded-theme border border-primary px-5 text-primary lg:w-auto"
			>
				{secondaryCta.label}
			</a>
		</div>
		<div class="order-2 overflow-hidden rounded-theme lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:h-full lg:min-h-80">
			{
				image ? (
					<img
						src={image.src}
						alt={image.alt}
						class="aspect-[4/3] w-full object-cover lg:aspect-auto lg:h-full lg:min-h-80"
					/>
				) : (
					<PhotoPlaceholder
						label={imageLabel}
						class="aspect-[4/3] lg:aspect-auto lg:h-full lg:min-h-80"
					/>
				)
			}
		</div>
	</div>
</section>
