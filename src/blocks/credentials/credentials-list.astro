---
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

interface EducationItem {
	title: string;
	year: number;
}

interface Props {
	title: string;
	items: EducationItem[];
	approachTitle: string;
	approachText: string;
	/** Якщо передано — показуємо кнопку. Текст кнопки береться з i18n. */
	certificatesButton?: { label: string };
}

const { title, items, approachTitle, approachText, certificatesButton } = Astro.props;
const ui = getUi("uk");
---

<section id="credentials" data-block="credentials-list">
	<div class="mx-auto max-w-6xl px-4 py-12 xl:px-8">
		<h2 class="text-3xl">{typograf(title)}</h2>
		<div class="mt-8 grid items-stretch gap-8 lg:grid-cols-12 lg:gap-x-10">
			<div class="flex h-full min-w-0 flex-col lg:col-span-6">
				<ul class="m-0 list-none p-0">
					{
						items.map((item) => (
							<li class="border-b border-border py-3 first:pt-0">
								<p class="font-body text-[15px] leading-[1.5]">
									{typograf(`${item.title} — ${item.year}`)}
								</p>
							</li>
						))
					}
				</ul>
				{
					certificatesButton && (
						<button
							type="button"
							class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-theme border border-primary px-5 text-primary lg:mt-auto lg:w-auto lg:self-start lg:pt-6"
						>
							{ui.credentials.certificates}
						</button>
					)
				}
			</div>
			<div class="min-w-0 lg:col-span-6">
				<article class="h-full rounded-theme border border-border bg-surface p-6">
					<h3 class="font-body text-[17px] font-semibold leading-snug">{typograf(approachTitle)}</h3>
					<p class="mt-3 font-body text-base leading-relaxed">{typograf(approachText)}</p>
				</article>
			</div>
		</div>
	</div>
</section>
