---
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

interface Props {
	title: string;
	text: string;
	points?: string[];
	primaryCta: { label: string; href: string; service?: string };
	secondaryCta: { label: string; href: string };
	card: {
		title: string;
		hours: string;
		address: string;
		note: string;
	};
}

const { title, text, points = [], primaryCta, secondaryCta, card } = Astro.props;
const ui = getUi("uk");

function splitOnce(value: string, separator: string) {
	const index = value.indexOf(separator);
	if (index < 0) return { main: value.trim(), extra: "" };
	return {
		main: value.slice(0, index).trim(),
		extra: value.slice(index + separator.length).trim().replace(/\.$/, ""),
	};
}

const hours = splitOnce(card.hours, ";");
const address = splitOnce(card.address, "·");
const note = splitOnce(card.note, ",");
const bookingPrefix = `${ui.hero.booking} у `;
const booking = {
	main: note.main.startsWith(bookingPrefix) ? note.main.slice(bookingPrefix.length) : note.main,
	extra: note.extra,
};

const rows = [
	{ key: "hours", label: ui.hero.hours, ...hours },
	{ key: "address", label: ui.hero.address, ...address },
	{ key: "booking", label: ui.hero.booking, ...booking },
];
---

<section id="hero" data-block="hero-info">
	<div
		class="mx-auto grid max-w-6xl items-center gap-6 px-4 py-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-x-10 lg:px-8 lg:py-12"
	>
		<div class="flex min-w-0 flex-col">
			<h1 class="font-heading text-[36px] leading-[1.15] lg:text-[56px]">{typograf(title)}</h1>
			<p class="mt-4 max-w-xl font-body text-base leading-relaxed">{text}</p>
			{
				points.length > 0 && (
					<ul class="mt-4 flex list-none flex-col gap-2 p-0">
						{points.map((point) => (
							<li class="flex items-start gap-2 font-body text-base">
								<span class="text-primary" aria-hidden="true">
									✓
								</span>
								<span>{point}</span>
							</li>
						))}
					</ul>
				)
			}
			<div class="mt-6 flex w-full flex-col items-start gap-3 lg:w-auto lg:flex-row">
				<a
					href={primaryCta.href}
					data-service={primaryCta.service}
					class="inline-flex min-h-11 w-full items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast lg:w-auto"
				>
					{primaryCta.label}
				</a>
				<a
					href={secondaryCta.href}
					class="inline-flex min-h-11 w-full items-center justify-center rounded-theme border border-primary px-5 text-primary lg:w-auto"
				>
					{secondaryCta.label}
				</a>
			</div>
		</div>
		<div class="w-full min-w-0 self-center rounded-theme border border-border bg-surface p-8">
			<p class="font-heading text-[20px] font-semibold leading-snug">{typograf(card.title)}</p>
			<ul class="mt-6 flex list-none flex-col gap-6 p-0">
				{
					rows.map((row) => (
						<li class="flex items-center gap-3">
							<span class="info-icon" aria-hidden="true">
								{row.key === "hours" && (
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="8" />
										<path d="M12 8v4.5l2.5 1.5" />
									</svg>
								)}
								{row.key === "address" && (
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 21s6-5.4 6-10a6 6 0 1 0-12 0c0 4.6 6 10 6 10z" />
										<circle cx="12" cy="11" r="2" />
									</svg>
								)}
								{row.key === "booking" && (
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
										<path d="M6 7h12a1.5 1.5 0 0 1 1.5 1.5v6A1.5 1.5 0 0 1 18 16h-6l-4 3v-3H6a1.5 1.5 0 0 1-1.5-1.5v-6A1.5 1.5 0 0 1 6 7z" />
									</svg>
								)}
							</span>
							<div class="min-w-0">
								<p class="font-body text-[13px] leading-tight text-muted">{row.label}</p>
								<p class="mt-1 font-body text-base font-medium leading-snug text-text">{row.main}</p>
								{row.extra && <p class="mt-0.5 font-body text-sm leading-snug text-muted">{row.extra}</p>}
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.info-icon {
		display: flex;
		width: 40px;
		height: 40px;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--color-primary) 14%, transparent);
		color: var(--color-primary);
	}
</style>
