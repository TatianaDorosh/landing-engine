---
import { typograf } from "../../lib/typograf";

interface Props {
	title: string;
	doesTitle: string;
	doesNotTitle: string;
	does: string[];
	doesNot: string[];
	note: string;
}

const { title, doesTitle, doesNotTitle, does, doesNot, note } = Astro.props;
---

<section id="services" data-block="services-scope" class="scroll-mt-24">
	<div class="mx-auto max-w-6xl min-w-0 px-4 py-12 xl:px-8">
		<h2 class="text-3xl">{typograf(title)}</h2>
		<div class="mt-8 grid gap-8 lg:grid-cols-12 lg:gap-x-10">
			<div class="min-w-0 lg:col-span-6">
				<h3 class="font-body text-lg font-semibold">{typograf(doesTitle)}</h3>
				<ul class="mt-4 flex list-none flex-col gap-3 p-0">
					{
						does.map((item) => (
							<li class="flex items-start gap-3">
								<span class="mt-0.5 inline-flex h-6 w-6 shrink-0 text-primary" aria-hidden="true">
									<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M20 6 9 17l-5-5" />
									</svg>
								</span>
								<p class="min-w-0 font-body text-[15px] leading-[1.5]">{typograf(item)}</p>
							</li>
						))
					}
				</ul>
			</div>
			<div class="min-w-0 lg:col-span-6">
				<h3 class="font-body text-lg font-semibold">{typograf(doesNotTitle)}</h3>
				<ul class="mt-4 flex list-none flex-col gap-3 p-0">
					{
						doesNot.map((item) => (
							<li class="flex items-start gap-3">
								<span class="mt-0.5 inline-flex h-6 w-6 shrink-0 text-muted" aria-hidden="true">
									<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M18 6 6 18" />
										<path d="m6 6 12 12" />
									</svg>
								</span>
								<p class="min-w-0 font-body text-[15px] leading-[1.5]">{typograf(item)}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<p class="mt-8 max-w-[760px] font-body text-[15px] leading-[1.5] text-muted">{typograf(note)}</p>
	</div>
</section>
