---
import type { SiteConfig } from "../../config/types";
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

type MessengerId = "telegram" | "viber" | "instagram";

interface Props {
	title: string;
	text: string;
	/** Короткий підпис під назвою кожного месенджера. */
	captions: Record<MessengerId, string>;
	/** Запасний рядок під кнопками. Якщо його немає, рядок збирається з графіка і телефону конфігу. */
	hint?: string;
	/** Нікнейм або номер під назвою месенджера. Без пропса показується. */
	showHandles?: boolean;
	/** Рядок графіка під кнопками. Без пропса показується. */
	showSchedule?: boolean;
	contacts: SiteConfig["contacts"];
	locale: SiteConfig["locale"];
}

const { title, text, captions, hint, contacts, locale, showHandles = true, showSchedule = true } = Astro.props;
const ui = getUi(locale);

function handle(value: string) {
	return value.replace(/^@/, "");
}

function isPlaceholder(value: string) {
	const trimmed = value.trim();
	return trimmed === "[ЗАПОВНИТИ]" || trimmed === "ЗАПОВНИТИ";
}

function viberHref(phone: string) {
	const digits = phone.replace(/\D/g, "");
	return `viber://chat?number=%2B${digits}`;
}

const messengers = [
	contacts.telegram
		? {
				id: "telegram" as const,
				href: isPlaceholder(contacts.telegram) ? "#" : `https://t.me/${handle(contacts.telegram)}`,
			}
		: null,
	contacts.viber
		? {
				id: "viber" as const,
				href: isPlaceholder(contacts.viber) ? "#" : viberHref(contacts.viber),
			}
		: null,
	contacts.instagram
		? {
				id: "instagram" as const,
				href: isPlaceholder(contacts.instagram) ? "#" : `https://instagram.com/${handle(contacts.instagram)}`,
			}
		: null,
].filter((item) => item !== null);

const phoneLabel = contacts.phoneDisplay ?? contacts.phone;
const tileClass =
	"flex min-h-16 w-full min-w-0 items-center gap-3 rounded-theme border px-4 py-3";
---

<section id="booking" data-block="booking-messengers" class="scroll-mt-24 border-y border-border bg-surface">
	<div class="mx-auto max-w-6xl min-w-0 px-4 py-12 xl:px-8">
		<h2 class="text-3xl">{typograf(title)}</h2>
		<p class="mt-4 max-w-none font-body text-base leading-relaxed text-muted lg:max-w-[640px]">{typograf(text)}</p>
		<ul class="m-0 mt-8 flex list-none flex-col gap-3 p-0 lg:grid lg:grid-cols-3">
				{
					messengers.map((item) => (
						<li class="min-w-0 lg:flex">
							<a
								href={item.href}
								data-messenger={item.id}
								class:list={[
									tileClass,
									"lg:h-full",
									item.id === "telegram"
										? "border-transparent bg-primary text-primary-contrast"
										: "border-border bg-transparent text-text hover:border-primary",
								]}
							>
								<span class="inline-flex h-6 w-6 shrink-0 items-center justify-center" aria-hidden="true">
									{item.id === "telegram" && (
										<svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
											<path d="M21.2 4.4 2.9 11.2c-.9.3-.9.9-.2 1.1l4.7 1.5 10.8-6.8c.5-.3 1-.1.6.2l-8.7 7.9-.3 4.6c.5 0 .7-.2 1-.5l2.4-2.3 5 3.7c.9.5 1.6.2 1.8-.9l3.3-15.4c.3-1.3-.5-1.9-1.5-1.5Z" />
										</svg>
									)}
									{item.id === "viber" && (
										<svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
											<path d="M12.2 3C7.6 3 4.2 6.2 4 10.6c-.1 2.3.7 4.3 2.2 5.8l-.7 3.2c-.1.5.4.9.8.6l3.3-1.8c.8.3 1.7.4 2.6.4 4.7 0 8.1-3.3 8.3-7.8C20.7 6.3 17.2 3 12.2 3Zm4.6 9.4c-.2.5-1.1 1-1.5 1.1-.4.1-.8.2-2.4-.5-2-.9-3.3-3-3.4-3.1-.1-.2-.9-1.2-.9-2.3s.6-1.6.8-1.8c.2-.2.4-.3.6-.3h.4c.1 0 .3 0 .5.4.2.5.6 1.6.7 1.7.1.1.1.3 0 .5-.1.2-.2.3-.3.5l-.2.3c-.1.1-.2.2-.1.4.2.3.7 1.1 1.5 1.8.9.8 1.7 1 2 .9.2-.1.4-.2.6-.4.1-.2.3-.1.5-.1l1.4.7c.2.1.4.2.4.3.1.2 0 .8-.2 1.1Z" />
										</svg>
									)}
									{item.id === "instagram" && (
										<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5">
											<rect x="4" y="4" width="16" height="16" rx="4" />
											<circle cx="12" cy="12" r="3.5" />
											<circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none" />
										</svg>
									)}
								</span>
								<span class="min-w-0 flex-1">
									<span class="block font-heading text-lg leading-snug break-words">{ui.messengers[item.id]}</span>
									{
										showHandles && (
											<span
												class:list={[
													"mt-0.5 block font-body text-[15px] leading-snug break-words",
													item.id === "telegram" ? "text-primary-contrast" : "text-muted",
												]}
											>
												{typograf(captions[item.id])}
											</span>
										)
									}
								</span>
								<svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
			{
				showSchedule && (hint || contacts.hours || contacts.phone) && (
					<p class="mt-4 font-body text-[15px] leading-[1.5] break-words">
						{hint ? (
							typograf(hint)
						) : (
							<>
								{contacts.hours && <span>{typograf(`${ui.messengers.hours} ${contacts.hours}.`)} </span>}
								{contacts.phone && (
									<>
										{ui.messengers.orCall}{" "}
										<a href={`tel:${contacts.phone}`} class="inline-flex min-h-11 items-center text-primary">
											{phoneLabel}
										</a>
									</>
								)}
							</>
						)}
					</p>
				)
			}
	</div>
</section>
