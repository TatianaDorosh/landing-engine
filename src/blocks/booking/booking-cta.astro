---
import type { SiteConfig } from "../../config/types";
import { typograf } from "../../lib/typograf";

interface Props {
	title: string;
	text: string;
	writeLabel: string;
	ctaLabel: string;
	ctaHref?: string;
	config: SiteConfig;
}

const { title, text, writeLabel, ctaLabel, ctaHref = "#booking", config } = Astro.props;
const telegramHandle = config.contacts.telegram?.replace(/^@/, "") ?? "";
const viberNumber = config.contacts.viber?.replace(/\D/g, "") ?? "";
const linkClass =
	"cta-soft inline-flex min-h-11 items-center underline decoration-1 underline-offset-2";
---

<section id="booking" data-block="booking-cta" class="scroll-mt-24">
	<div class="mx-auto max-w-6xl px-4 py-12 xl:px-8">
		<div class="grid gap-6 rounded-theme bg-primary p-7 text-primary-contrast lg:grid-cols-12 lg:items-center lg:gap-8 lg:p-12">
			<div class="min-w-0 lg:col-span-6">
				<h2 class="font-heading text-3xl text-primary-contrast">{typograf(title)}</h2>
				<p class="cta-soft mt-4 font-body text-base leading-relaxed">{text}</p>
			</div>
			<div class="min-w-0 lg:col-span-6">
				<a
					href={ctaHref}
					class="inline-flex min-h-11 w-full items-center justify-center rounded-theme bg-surface px-5 text-primary lg:w-auto"
				>
					{ctaLabel}
				</a>
				{
					(telegramHandle || viberNumber) && (
						<p class="cta-soft mt-3.5 font-body text-sm leading-relaxed">
							{writeLabel}{" "}
							{telegramHandle && (
								<a href={`https://t.me/${telegramHandle}`} data-messenger="telegram" class={linkClass}>
									Telegram
								</a>
							)}
							{telegramHandle && viberNumber && <span aria-hidden="true"> · </span>}
							{viberNumber && (
								<a href={`viber://chat?number=%2B${viberNumber}`} data-messenger="viber" class={linkClass}>
									Viber
								</a>
							)}
						</p>
					)
				}
				{
					config.contacts.hours && (
						<p class="cta-soft mt-1 font-body text-sm leading-relaxed">{config.contacts.hours}</p>
					)
				}
			</div>
		</div>
	</div>
</section>

<style is:global>
	[data-block="booking-cta"] .cta-soft {
		color: color-mix(in srgb, var(--color-primary-contrast) 90%, transparent);
	}

	[data-block="booking-cta"] :focus-visible {
		outline: 2px solid var(--color-primary-contrast);
		outline-offset: 2px;
	}
</style>
