---
import CertificatesDialog from "../../components/CertificatesDialog.astro";
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

interface DocumentImage {
	src: string;
	alt: string;
	width: number;
	height: number;
}

interface DocumentItem {
	kind: "license" | "diploma" | "certificate";
	title: string;
	caption: string;
	image?: DocumentImage;
}

interface Props {
	title: string;
	intro: string;
	documents: DocumentItem[];
	sterilization: { title: string; points: string[] };
}

// Велике фото відкриває CertificatesDialog (view="single"): той самий скрипт, Esc і фокус назад на картку.
const { title, intro, documents, sterilization } = Astro.props;
const ui = getUi("uk");
const dialogItems = documents.map((doc) => ({
	name: doc.title,
	certificates: [
		{
			label: doc.caption,
			...(doc.image?.src && doc.image.alt
				? {
						image: {
							src: doc.image.src,
							alt: doc.image.alt,
							width: doc.image.width,
							height: doc.image.height,
						},
					}
				: {}),
		},
	],
}));
---

<section id="licenses" data-block="licenses-docs">
	<div class="mx-auto max-w-6xl px-4 py-12 xl:px-8">
		<h2 class="text-3xl">{typograf(title)}</h2>
		<p class="mt-4 max-w-[760px] font-body text-base leading-relaxed">{typograf(intro)}</p>
		<ul
			data-docs-track
			class="mt-6 flex w-full min-w-0 list-none snap-x snap-mandatory gap-3 overflow-x-auto overflow-y-hidden overscroll-x-contain p-0 sm:grid sm:snap-none sm:grid-cols-3 sm:gap-6 sm:overflow-visible"
		>
			{
				documents.map((doc, index) => {
					const photo = doc.image?.src && doc.image.alt ? doc.image : undefined;
					return (
						<li class="h-full min-w-0 w-[min(72vw,280px)] shrink-0 snap-start sm:w-auto">
							<button
								type="button"
								data-certs-open={index}
								data-kind={doc.kind}
								aria-haspopup="dialog"
								aria-label={`${ui.licenses.open}: ${doc.title}. ${doc.caption}`}
								class="flex h-full w-full flex-col items-stretch overflow-hidden rounded-theme border border-border bg-surface p-0 text-left sm:min-h-11"
							>
								<div class="relative aspect-[3/4] w-full overflow-hidden bg-bg sm:aspect-auto sm:h-[340px] sm:rounded-none">
									{photo ? (
										<img
											src={photo.src}
											alt={photo.alt}
											width={photo.width}
											height={photo.height}
											loading="lazy"
											decoding="async"
											class="absolute inset-2 h-[calc(100%-16px)] w-[calc(100%-16px)] object-contain object-center sm:inset-0 sm:h-full sm:w-full"
										/>
									) : (
										<PhotoPlaceholder
											label={doc.caption}
											ratio="3/4"
											class="absolute inset-0 h-full sm:!px-4 sm:!text-sm sm:!leading-normal"
										/>
									)}
								</div>
								<div class="flex min-w-0 flex-1 flex-col p-4 sm:p-5">
									<h3 class="font-body text-[17px] font-semibold leading-snug">{typograf(doc.title)}</h3>
									<p class="mt-1 font-body text-[15px] leading-[1.5] text-muted sm:mt-auto sm:pt-2">{typograf(doc.caption)}</p>
								</div>
							</button>
						</li>
					);
				})
			}
		</ul>
		<article class="mt-3 rounded-theme border border-border bg-surface p-5 sm:mt-6">
			<h3 class="font-body text-[17px] font-semibold leading-snug">{typograf(sterilization.title)}</h3>
			<ul class="mt-4 flex list-none flex-col gap-3 p-0 md:grid md:grid-cols-3 md:gap-6">
				{
					sterilization.points.map((point) => (
						<li class="flex items-start gap-3">
							<span class="mt-0.5 shrink-0 font-body text-[15px] font-semibold text-primary" aria-hidden="true">
								✓
							</span>
							<span class="min-w-0 font-body text-[15px] leading-[1.5]">{typograf(point)}</span>
						</li>
					))
				}
			</ul>
		</article>
	</div>
	<CertificatesDialog view="single" items={dialogItems} />
</section>

<style>
	[data-docs-track] {
		scrollbar-width: none;
	}
	[data-docs-track]::-webkit-scrollbar {
		display: none;
	}
	@media (min-width: 640px) {
		[data-docs-track] {
			scrollbar-width: auto;
		}
	}
</style>
