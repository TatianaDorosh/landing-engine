---
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { typograf } from "../../lib/typograf";

interface ServiceItem {
	title: string;
	text: string;
	priceFrom: number;
	linkLabel: string;
	href: string;
	/** Якщо задано, кнопка передає послугу в панель запису. */
	service?: string;
	imageLabel: string;
	/** Доступна назва заглушки. Якщо не передано — розмітка як раніше. */
	imageAlt?: string;
	image?: { src: string; alt: string; width: number; height: number };
}

interface Props {
	title: string;
	currency: string;
	items: ServiceItem[];
	/** Пробіл у тисячах. Без цього пропса ціна як раніше, числом. */
	groupThousands?: boolean;
}

const { title, currency, items, groupThousands = false } = Astro.props;

function grouped(value: number) {
	return String(value).replace(/\B(?=(\d{3})+(?!\d))/g, "\u00a0");
}
---

<section id="services" data-block="services-cards">
	<div class="mx-auto max-w-6xl px-4 py-12 xl:px-8 xl:py-16">
		<h2 class="text-3xl">{typograf(title)}</h2>
		<ul class="mt-6 grid list-none grid-cols-1 gap-4 p-0 xl:grid-cols-3">
			{
				items.map((item) => (
					<li class="h-full">
						<article class="flex h-full flex-col overflow-hidden rounded-theme border border-border bg-surface">
							{item.image ? (
								<div class="relative aspect-[4/3] w-full overflow-hidden">
									<img
										src={item.image.src}
										alt={item.image.alt}
										width={item.image.width}
										height={item.image.height}
										loading="lazy"
										decoding="async"
										class="absolute inset-0 h-full w-full object-cover"
									/>
								</div>
							) : (
								<PhotoPlaceholder label={item.imageLabel} alt={item.imageAlt} ratio="4/3" />
							)}
							<div class="flex flex-1 flex-col p-5">
								<h3 class="font-body text-2xl font-semibold">{typograf(item.title)}</h3>
								<p class="mt-3 font-body leading-relaxed">{item.text}</p>
								<div class="mt-auto pt-4">
									<p class="font-heading text-[28px] text-primary">
										від {groupThousands ? grouped(item.priceFrom) : item.priceFrom} {currency}
									</p>
									<a
										href={item.href}
										data-service={item.service}
										class="inline-flex min-h-11 items-center pt-4 text-primary"
									>
										{item.linkLabel}
									</a>
								</div>
							</div>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>
