---
import type { SiteConfig } from "../config/types";
import { getUi } from "../i18n";
import { typograf } from "../lib/typograf";

interface ServiceGroup {
	group: string;
	items: string[];
}

interface Props {
	services: ServiceGroup[];
	masters: string[];
	privacyHref: string;
	config: SiteConfig;
	/** Унікальний префікс id, якщо на сторінці дві форми. */
	idPrefix?: string;
	/** Панель: поля одне під одним, дата й час парою. */
	stacked?: boolean;
	/** Кнопка «Закрити» на екрані успіху. */
	successClose?: boolean;
}

const {
	services,
	masters,
	privacyHref,
	config,
	idPrefix = "booking",
	stacked = false,
	successClose = false,
} = Astro.props;
const ui = getUi(config.locale);
const staffLabel = config.staffLabel ?? "Майстер";
const phoneDisplay = config.contacts.phoneDisplay ?? config.contacts.phone;
const fieldClass =
	"w-full min-w-0 max-w-full rounded-theme border border-border bg-bg px-3 font-body text-base text-text";
const methods = [
	{ id: "telegram", label: ui.form.methods.telegram },
	{ id: "viber", label: ui.form.methods.viber },
	{ id: "sms", label: ui.form.methods.sms },
	{ id: "call", label: ui.form.methods.call },
] as const;
const pairClass = stacked ? "grid gap-3.5" : "grid gap-3.5 md:grid-cols-2";
const datePairClass = stacked
	? "grid grid-cols-1 gap-3.5 min-[420px]:grid-cols-2"
	: "grid gap-3.5 md:grid-cols-2";
const id = (name: string) => `${idPrefix}-${name}`;
---

<div data-booking-root>
	<form class="grid gap-3.5" novalidate data-booking-form>
		<div class={pairClass}>
			<div>
				<label for={id("name")} class="font-body text-[15px] font-semibold">{ui.form.name}</label>
				<input
					id={id("name")}
					name="name"
					type="text"
					autocomplete="name"
					data-field="name"
					class:list={[fieldClass, "mt-1 min-h-11"]}
					aria-describedby={id("error-name")}
				/>
				<p id={id("error-name")} class="mt-1 font-body text-sm text-primary" data-error="name" hidden></p>
			</div>

			<div>
				<label for={id("phone")} class="font-body text-[15px] font-semibold">{ui.form.phone}</label>
				<input
					id={id("phone")}
					name="phone"
					type="tel"
					inputmode="tel"
					autocomplete="tel"
					placeholder="+380 XX XXX XX XX"
					data-field="phone"
					class:list={[fieldClass, "mt-1 min-h-11"]}
					aria-describedby={id("error-phone")}
				/>
				<p id={id("error-phone")} class="mt-1 font-body text-sm text-primary" data-error="phone" hidden></p>
			</div>
		</div>

		<div class={pairClass}>
			<div>
				<label for={id("service")} class="font-body text-[15px] font-semibold">{ui.form.service}</label>
				<select
					id={id("service")}
					name="service"
					data-field="service"
					class:list={[fieldClass, "mt-1 min-h-11"]}
					aria-describedby={id("error-service")}
				>
					<option value="">Оберіть послугу</option>
					{
						services.map((group) => (
							<optgroup label={group.group.toLocaleUpperCase("uk")}>
								{group.items.map((item) => (
									<option value={item}>{item}</option>
								))}
							</optgroup>
						))
					}
				</select>
				<p id={id("error-service")} class="mt-1 font-body text-sm text-primary" data-error="service" hidden></p>
			</div>

			<div>
				<label for={id("master")} class="font-body text-[15px] font-semibold">{staffLabel}</label>
				<select id={id("master")} name="master" data-field="master" class:list={[fieldClass, "mt-1 min-h-11"]}>
					<option value="Будь-який" selected>Будь-який</option>
					{masters.map((name) => <option value={name}>{name}</option>)}
				</select>
			</div>
		</div>

		<div class={datePairClass}>
			<div class="min-w-0">
				<label for={id("date")} class="font-body text-[15px] font-semibold">{ui.form.date}</label>
				<input
					id={id("date")}
					name="date"
					type="date"
					data-field="date"
					class:list={[fieldClass, "mt-1 min-h-11"]}
					aria-describedby={id("error-date")}
				/>
				<p id={id("error-date")} class="mt-1 font-body text-sm text-primary" data-error="date" hidden></p>
			</div>
			<div class="min-w-0">
				<label for={id("time")} class="font-body text-[15px] font-semibold">{ui.form.time}</label>
				<select
					id={id("time")}
					name="time"
					data-field="time"
					class:list={[fieldClass, "mt-1 min-h-11"]}
					aria-describedby={id("error-time")}
				>
					<option value="">{ui.errors.pickDate}</option>
				</select>
				<p id={id("error-time")} class="mt-1 font-body text-sm text-primary" data-error="time" hidden></p>
				<p class="mt-1 font-body text-sm text-muted" data-time-hint hidden>{ui.errors.noSlotsToday}</p>
			</div>
		</div>

		<fieldset class="min-w-0 border-0 p-0" data-field="method">
			<legend class="font-body text-[15px] font-semibold">{ui.form.contactMethod}</legend>
			<div
				class:list={[
					"mt-2 grid grid-cols-2 gap-2 min-[420px]:flex",
					stacked ? "min-[420px]:flex-wrap" : "min-[420px]:flex-nowrap",
				]}
			>
				{
					methods.map((method) => (
						<label class="inline-flex min-h-11 w-full min-w-0 items-center gap-2 rounded-full border border-border px-3 font-body text-[15px] min-[420px]:w-auto min-[420px]:shrink-0">
							<input
								type="radio"
								name="contact"
								value={method.id}
								data-label={method.label}
								checked={method.id === "telegram"}
								class="h-4 w-4"
							/>
							{method.label}
						</label>
					))
				}
			</div>
			<label class="mt-2 inline-flex min-h-11 items-center gap-3 font-body text-[15px]">
				<input type="checkbox" name="doNotCall" data-field="do-not-call" class="h-4 w-4 shrink-0" />
				{ui.form.doNotCall}
			</label>
		</fieldset>

		<div>
			<button
				type="button"
				data-comment-toggle
				class="inline-flex min-h-11 items-center font-body text-[15px] text-primary"
				aria-expanded="false"
				aria-controls={id("comment-panel")}
			>
				+ Додати коментар
			</button>
			<div id={id("comment-panel")} data-comment-panel hidden>
				<label for={id("comment")} class="font-body text-[15px] font-semibold">{ui.form.comment}</label>
				<p class="mt-1 font-body text-sm text-muted">Можна вказати номер сертифіката</p>
				<textarea
					id={id("comment")}
					name="comment"
					rows="3"
					data-field="comment"
					class:list={[fieldClass, "mt-1 py-3"]}
				></textarea>
			</div>
		</div>

		<p class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
			<label>
				Не заповнюйте
				<input type="text" name="botcheck" tabindex="-1" autocomplete="off" data-field="botcheck" />
			</label>
		</p>

		<div>
			<label class="flex items-start gap-3 font-body text-[15px] leading-[1.5]">
				<input
					type="checkbox"
					name="consent"
					data-field="consent"
					class="mt-1 h-4 w-4 shrink-0"
					aria-describedby={id("error-consent")}
				/>
				<span>
					{ui.form.consentBefore}<a href={privacyHref} target="_blank" rel="noopener" class="text-primary underline">{ui.form.consentLink}</a>{ui.form.consentAfter}
				</span>
			</label>
			<p id={id("error-consent")} class="mt-1 font-body text-sm text-primary" data-error="consent" hidden></p>
		</div>

		<p class="font-body text-[15px] leading-[1.5]" data-form-error role="alert" hidden></p>

		<button
			type="submit"
			data-submit
			class="inline-flex min-h-11 w-full items-center justify-center rounded-theme bg-primary px-5 font-body text-primary-contrast sm:w-auto"
		>
			{ui.buttons.submit}
		</button>
	</form>

	<div data-success hidden>
		<h3 tabindex="-1" data-success-title class="font-body text-xl font-semibold">{typograf(ui.success.title)}</h3>
		<p class="mt-3 font-body text-[15px] leading-[1.6] xl:text-base">{ui.success.text}</p>
		<p class="mt-3 font-body text-sm text-muted" data-demo-note hidden>Демо: заявку не надіслано</p>
		{
			successClose && (
				<button
					type="button"
					data-booking-success-close
					class="mt-6 inline-flex min-h-11 items-center justify-center self-start rounded-theme bg-primary px-5 text-primary-contrast"
				>
					{ui.buttons.close}
				</button>
			)
		}
	</div>
</div>

<style is:global>
	[data-booking-root] [aria-invalid="true"] {
		border-color: var(--color-primary);
	}

	[data-booking-root] label:has(input:disabled) {
		color: var(--color-muted);
	}
</style>

<script
	define:vars={{
		web3formsKey: config.booking.web3formsKey,
		siteName: config.name,
		phone: config.contacts.phone,
		phoneDisplay,
		hoursSchema: config.contacts.hoursSchema ?? [],
		stepMinutes: config.booking.stepMinutes,
		submitLabel: ui.buttons.submit,
		sendingLabel: "Надсилаємо…",
		messages: ui.errors,
		labels: {
			name: ui.form.name,
			phone: ui.form.phone,
			service: ui.form.service,
			master: staffLabel,
			date: ui.form.date,
			time: ui.form.time,
			contactMethod: ui.form.contactMethod,
			doNotCall: ui.form.doNotCall,
			comment: ui.form.comment,
		},
	}}
>
	function formatUaPhone(value) {
		let digits = String(value).replace(/\D/g, "");
		while (digits.startsWith("380") || digits.startsWith("38")) {
			if (digits.startsWith("380")) digits = digits.slice(3);
			else digits = digits.slice(2);
		}
		digits = digits.replace(/^0+/, "").slice(0, 9);
		let out = "+380";
		if (!digits) return out;
		out += " " + digits.slice(0, 2);
		if (digits.length > 2) out += " " + digits.slice(2, 5);
		if (digits.length > 5) out += " " + digits.slice(5, 7);
		if (digits.length > 7) out += " " + digits.slice(7, 9);
		return out;
	}

	function compactPhone(value) {
		return formatUaPhone(value).replace(/\s/g, "");
	}

	function isCompletePhone(value) {
		return /^\+380\d{9}$/.test(compactPhone(value)) && String(value).replace(/\D/g, "").length > 0;
	}

	function todayValue() {
		const now = new Date();
		const month = String(now.getMonth() + 1).padStart(2, "0");
		const day = String(now.getDate()).padStart(2, "0");
		return now.getFullYear() + "-" + month + "-" + day;
	}

	const weekdays = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
	const weekdayNames = ["неділя", "понеділок", "вівторок", "середа", "четвер", "п'ятниця", "субота"];

	function clockMinutes(value) {
		const parts = String(value).split(":");
		return Number(parts[0]) * 60 + Number(parts[1]);
	}

	function formatSlot(total) {
		const hours = Math.floor(total / 60);
		const mins = total % 60;
		return String(hours).padStart(2, "0") + ":" + String(mins).padStart(2, "0");
	}

	function parseDate(value) {
		const parts = String(value).split("-").map(Number);
		return new Date(parts[0], parts[1] - 1, parts[2]);
	}

	function formatBookingDate(value) {
		const parts = String(value).split("-");
		const date = parseDate(value);
		return parts[2] + "." + parts[1] + "." + parts[0] + ", " + weekdayNames[date.getDay()];
	}

	function slotsForDate(value) {
		const date = parseDate(value);
		const dayName = weekdays[date.getDay()];
		const hours = (hoursSchema || []).find((row) => {
			const days = row.dayOfWeek;
			return Array.isArray(days) ? days.indexOf(dayName) !== -1 : days === dayName;
		});
		if (!hours) return [];
		const start = clockMinutes(hours.opens);
		const end = clockMinutes(hours.closes) - 60;
		const slots = [];
		for (let cursor = start; cursor <= end; cursor += stepMinutes) {
			slots.push(formatSlot(cursor));
		}
		return slots;
	}

	function slotTooSoon(dateValue, slot) {
		if (dateValue !== todayValue()) return false;
		const now = new Date();
		const cutoff = now.getHours() * 60 + now.getMinutes() + 60;
		return clockMinutes(slot) < cutoff;
	}

	function field(root, name) {
		return root.querySelector("[data-field='" + name + "']");
	}

	function showError(root, name, message) {
		const error = root.querySelector("[data-error='" + name + "']");
		const input = field(root, name);
		if (error) {
			error.textContent = message;
			error.hidden = !message;
		}
		if (input) {
			if (message) input.setAttribute("aria-invalid", "true");
			else input.removeAttribute("aria-invalid");
		}
	}

	function chooseOption(select, value) {
		if (!value) return;
		const existing = [...select.options].find((option) => option.value === value);
		if (existing) {
			select.value = value;
			return;
		}
		const option = document.createElement("option");
		option.value = value;
		option.textContent = value;
		select.append(option);
		select.value = value;
	}

	function bindBooking(root) {
		if (!(root instanceof HTMLElement) || root.dataset.bookingBound === "true") return;
		root.dataset.bookingBound = "true";
		const form = root.querySelector("[data-booking-form]");
		const phoneInput = field(root, "phone");
		const dateInput = field(root, "date");
		const callInput = root.querySelector("input[value='call']");
		const telegramInput = root.querySelector("input[value='telegram']");
		const doNotCall = field(root, "do-not-call");
		const submit = root.querySelector("[data-submit]");
		const errorBox = root.querySelector("[data-form-error]");
		const success = root.querySelector("[data-success]");
		const successTitle = root.querySelector("[data-success-title]");
		const demoNote = root.querySelector("[data-demo-note]");
		let sending = false;

		dateInput.min = todayValue();

		function refillTime() {
			const timeSelect = field(root, "time");
			const hint = root.querySelector("[data-time-hint]");
			const previous = timeSelect.value;
			const date = dateInput.value;
			timeSelect.replaceChildren();
			if (!date) {
				const option = document.createElement("option");
				option.value = "";
				option.textContent = messages.pickDate;
				timeSelect.append(option);
				if (hint) hint.hidden = true;
				return;
			}
			const placeholder = document.createElement("option");
			placeholder.value = "";
			placeholder.textContent = messages.time;
			timeSelect.append(placeholder);
			let anyFree = false;
			slotsForDate(date).forEach((slot) => {
				const option = document.createElement("option");
				option.value = slot;
				option.textContent = slot;
				if (slotTooSoon(date, slot)) option.disabled = true;
				else anyFree = true;
				timeSelect.append(option);
			});
			const kept = [...timeSelect.options].find((option) => option.value === previous && !option.disabled);
			timeSelect.value = kept ? previous : "";
			if (hint) hint.hidden = !(date === todayValue() && !anyFree);
		}

		dateInput.addEventListener("change", refillTime);
		refillTime();

		function resetForm() {
			sending = false;
			form.hidden = false;
			success.hidden = true;
			demoNote.hidden = true;
			errorBox.hidden = true;
			errorBox.replaceChildren();
			["name", "phone", "service", "date", "time", "consent"].forEach((name) => showError(root, name, ""));
			field(root, "name").value = "";
			phoneInput.value = "";
			field(root, "service").value = "";
			field(root, "master").value = "Будь-який";
			dateInput.value = "";
			refillTime();
			field(root, "consent").checked = false;
			doNotCall.checked = false;
			callInput.disabled = false;
			telegramInput.checked = true;
			field(root, "comment").value = "";
			field(root, "botcheck").value = "";
			const commentToggle = root.querySelector("[data-comment-toggle]");
			const commentPanel = root.querySelector("[data-comment-panel]");
			commentToggle?.setAttribute("aria-expanded", "false");
			if (commentPanel) commentPanel.hidden = true;
			submit.disabled = false;
			submit.textContent = submitLabel;
		}

		root.addEventListener("booking-reset", resetForm);

		const commentToggle = root.querySelector("[data-comment-toggle]");
		const commentPanel = root.querySelector("[data-comment-panel]");
		const commentField = field(root, "comment");
		commentToggle?.addEventListener("click", () => {
			const open = commentToggle.getAttribute("aria-expanded") !== "true";
			commentToggle.setAttribute("aria-expanded", open ? "true" : "false");
			if (commentPanel) commentPanel.hidden = !open;
			if (open && commentField instanceof HTMLTextAreaElement) commentField.focus();
		});

		phoneInput.addEventListener("focus", () => {
			if (!phoneInput.value) phoneInput.value = "+380";
		});
		phoneInput.addEventListener("input", () => {
			phoneInput.value = formatUaPhone(phoneInput.value);
		});
		phoneInput.addEventListener("paste", (event) => {
			event.preventDefault();
			const pasted = (event.clipboardData || window.clipboardData).getData("text");
			phoneInput.value = formatUaPhone(pasted);
		});
		phoneInput.addEventListener("blur", () => {
			if (compactPhone(phoneInput.value) === "+380") phoneInput.value = "";
		});

		doNotCall.addEventListener("change", () => {
			callInput.disabled = doNotCall.checked;
			if (doNotCall.checked && callInput.checked) telegramInput.checked = true;
		});

		function validate() {
			["name", "phone", "service", "date", "time", "consent"].forEach((name) => showError(root, name, ""));
			let valid = true;
			let first = null;
			const name = field(root, "name").value.trim();
			const phone = phoneInput.value.trim();
			const service = field(root, "service").value;
			const date = dateInput.value;
			const timeSelect = field(root, "time");
			const time = timeSelect.value;
			const timeOption = timeSelect.selectedOptions[0];
			const consent = field(root, "consent").checked;

			if (name.length < 2) {
				showError(root, "name", messages.required);
				valid = false;
				first = first || field(root, "name");
			}
			if (!phone || compactPhone(phone) === "+380") {
				showError(root, "phone", messages.required);
				valid = false;
				first = first || phoneInput;
			} else if (!isCompletePhone(phone)) {
				showError(root, "phone", messages.phone);
				valid = false;
				first = first || phoneInput;
			}
			if (!service) {
				showError(root, "service", messages.required);
				valid = false;
				first = first || field(root, "service");
			}
			if (!date || date < dateInput.min) {
				showError(root, "date", messages.date);
				valid = false;
				first = first || dateInput;
			}
			if (!time || (timeOption && timeOption.disabled)) {
				showError(root, "time", messages.time);
				valid = false;
				first = first || field(root, "time");
			}
			if (!consent) {
				showError(root, "consent", messages.consent);
				valid = false;
				first = first || field(root, "consent");
			}
			if (first) first.focus();
			return valid;
		}

		function showSuccess(isDemo) {
			form.hidden = true;
			success.hidden = false;
			demoNote.hidden = !isDemo;
			successTitle.focus();
		}

		function showSendError() {
			errorBox.replaceChildren();
			errorBox.append(document.createTextNode(messages.send + " "));
			const link = document.createElement("a");
			link.href = "tel:" + phone;
			link.textContent = phoneDisplay;
			link.className = "inline-flex min-h-11 items-center text-primary underline";
			errorBox.append(link);
			errorBox.hidden = false;
		}

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (sending) return;
			errorBox.hidden = true;
			if (!validate()) return;
			if (field(root, "botcheck").value.trim()) {
				showSuccess(false);
				return;
			}
			if (web3formsKey === "ЗАПОВНИТИ") {
				showSuccess(true);
				return;
			}

			sending = true;
			submit.disabled = true;
			submit.textContent = sendingLabel;
			const method = root.querySelector("input[name='contact']:checked");
			const payload = {
				access_key: web3formsKey,
				subject: "Нова заявка — " + siteName,
			};
			payload[labels.name] = field(root, "name").value.trim();
			payload[labels.phone] = compactPhone(phoneInput.value);
			payload[labels.service] = field(root, "service").value;
			payload[labels.master] = field(root, "master").value;
			payload[labels.date] = formatBookingDate(dateInput.value);
			payload[labels.time] = field(root, "time").value;
			payload[labels.contactMethod] = method ? method.dataset.label : "";
			payload[labels.doNotCall] = doNotCall.checked ? "Так" : "Ні";
			payload[labels.comment] = field(root, "comment").value.trim();

			try {
				const response = await fetch("https://api.web3forms.com/submit", {
					method: "POST",
					headers: { "Content-Type": "application/json", Accept: "application/json" },
					body: JSON.stringify(payload),
				});
				const result = await response.json();
				if (!response.ok || !result.success) throw new Error("send");
				showSuccess(false);
			} catch (error) {
				showSendError();
				sending = false;
				submit.disabled = false;
				submit.textContent = submitLabel;
			}
		});
	}

	function onPrefill(event) {
		const link = event.target.closest("a[data-service], a[data-master]");
		if (!link) return;
		const root = document.querySelector("[data-block='booking-form']");
		if (!root) return;
		const service = link.getAttribute("data-service");
		const master = link.getAttribute("data-master");
		if (service) chooseOption(field(root, "service"), service);
		if (master) chooseOption(field(root, "master"), master);
		const name = field(root, "name");
		setTimeout(() => name.focus(), 0);
	}

	document.querySelectorAll("[data-booking-root]").forEach(bindBooking);
	if (document.documentElement.dataset.bookingPrefill !== "true") {
		document.documentElement.dataset.bookingPrefill = "true";
		document.addEventListener("click", onPrefill);
	}
</script>
