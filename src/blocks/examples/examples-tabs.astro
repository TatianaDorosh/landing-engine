---
import type { Locale } from "../../config/types";
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

interface ExampleImage {
	src: string;
	alt: string;
	width?: number;
	height?: number;
}

interface ExampleCard {
	name: string;
	href: string;
	forWhom: string;
	imageLabel: string;
	image?: ExampleImage;
}

interface ExampleGroup {
	name: string;
	flagship?: ExampleCard | null;
	templates: ExampleCard[];
}

interface Props {
	title: string;
	count: number | null;
	countEmpty: string;
	countFilled: string;
	intro: string;
	groups: ExampleGroup[];
	soonLabel: string;
	comingSoon: string[];
	fallback: string;
	locale?: Locale;
	bookingHref?: string;
}

const {
	title,
	count,
	countEmpty,
	countFilled,
	intro,
	groups,
	soonLabel,
	comingSoon,
	fallback,
	locale = "uk",
	bookingHref = "#booking",
} = Astro.props;

const ui = getUi(locale);
const visibleGroups = groups.filter((group) => Boolean(group.flagship) || group.templates.length > 0);
const countHeading = count == null ? countEmpty : countFilled.replace("{count}", String(count));

const primaryButton =
	"inline-flex min-h-11 w-full items-center justify-center rounded-theme bg-primary px-5 text-center text-primary-contrast lg:w-auto";
const secondaryButton =
	"inline-flex min-h-11 w-full items-center justify-center rounded-theme border border-primary px-5 text-center text-primary lg:w-auto";
---

<section id="examples" data-block="examples-tabs" class="scroll-mt-24">
	<div class="mx-auto max-w-6xl min-w-0 px-4 py-12 xl:px-8">
		<h2 class="text-3xl">{typograf(title)}</h2>
		<h3 class="mt-4 font-body text-lg font-semibold">{typograf(countHeading)}</h3>
		<p class="mt-3 max-w-[760px] font-body text-base leading-relaxed">{typograf(intro)}</p>

		{
			visibleGroups.length > 0 && (
				<div class="mt-6 max-w-full overflow-x-auto overscroll-x-contain">
					<div class="flex w-max flex-nowrap gap-2 py-1" role="tablist" aria-label={title}>
						{visibleGroups.map((group, index) => (
							<button
								type="button"
								role="tab"
								id={`examples-tab-${index}`}
								data-example-tab={index}
								aria-selected={index === 0 ? "true" : "false"}
								aria-controls={`examples-panel-${index}`}
								class:list={[
									"inline-flex min-h-11 shrink-0 items-center rounded-theme px-4",
									index === 0 ? "bg-primary text-primary-contrast" : "border border-border text-text",
								]}
							>
								{group.name}
							</button>
						))}
					</div>
				</div>
			)
		}

		{
			visibleGroups.map((group, index) => (
				<div
					role="tabpanel"
					id={`examples-panel-${index}`}
					data-example-panel={index}
					aria-labelledby={`examples-tab-${index}`}
					hidden={index !== 0}
					class="mt-6 min-w-0"
				>
					{group.flagship && (
						<article class="overflow-hidden rounded-theme border border-border bg-surface lg:grid lg:grid-cols-12 lg:items-stretch">
							<div class="relative aspect-[4/3] min-h-48 lg:col-span-7 lg:aspect-auto lg:min-h-[320px]">
								{group.flagship.image ? (
									<img
										src={group.flagship.image.src}
										alt={group.flagship.image.alt}
										width={group.flagship.image.width}
										height={group.flagship.image.height}
										loading="lazy"
										decoding="async"
										class="absolute inset-0 h-full w-full object-cover"
									/>
								) : (
									<PhotoPlaceholder label={group.flagship.imageLabel} class="absolute inset-0 h-full" />
								)}
							</div>
							<div class="flex min-w-0 flex-col p-5 lg:col-span-5">
								<h3 class="font-body text-lg font-semibold">{typograf(group.flagship.name)}</h3>
								<p class="mt-1 font-body text-[15px] leading-[1.5] text-muted">{typograf(group.flagship.forWhom)}</p>
								<div class="mt-auto flex flex-col gap-2 pt-5 lg:flex-row lg:flex-wrap">
									<a href={group.flagship.href} target="_blank" rel="noopener" class={primaryButton}>
										{ui.buttons.openDemo}
									</a>
									<a href={bookingHref} class={secondaryButton}>
										{ui.buttons.wantThis}
									</a>
								</div>
							</div>
						</article>
					)}
					{group.templates.length > 0 && (
						<ul class:list={["m-0 grid list-none gap-4 p-0 sm:grid-cols-2", group.flagship && "mt-4"]}>
							{group.templates.map((item) => (
								<li class="h-full min-w-0">
									<article class="flex h-full flex-col overflow-hidden rounded-theme border border-border bg-surface">
										<div class="relative aspect-[4/3] w-full">
											{item.image ? (
												<img
													src={item.image.src}
													alt={item.image.alt}
													width={item.image.width}
													height={item.image.height}
													loading="lazy"
													decoding="async"
													class="absolute inset-0 h-full w-full object-cover"
												/>
											) : (
												<PhotoPlaceholder label={item.imageLabel} class="absolute inset-0 h-full" />
											)}
										</div>
										<div class="flex flex-1 flex-col p-5">
											<h3 class="font-body text-lg font-semibold">{typograf(item.name)}</h3>
											<p class="mt-1 font-body text-[15px] leading-[1.5] text-muted">{typograf(item.forWhom)}</p>
											<div class="mt-auto flex flex-col gap-2 pt-5 lg:flex-row lg:flex-wrap">
												<a href={item.href} target="_blank" rel="noopener" class={primaryButton}>
													{ui.buttons.openDemo}
												</a>
												<a href={bookingHref} class={secondaryButton}>
													{ui.buttons.wantThis}
												</a>
											</div>
										</div>
									</article>
								</li>
							))}
						</ul>
					)}
				</div>
			))
		}

		{
			comingSoon.length > 0 && (
				<p class="mt-6 font-body text-[15px] leading-[1.5] text-muted">
					{soonLabel}: {comingSoon.join(", ")}
				</p>
			)
		}

		<p class="mt-8 max-w-[760px] font-body text-[15px] leading-[1.5]">{typograf(fallback)}</p>
		<a href={bookingHref} class:list={["mt-4", primaryButton]}>{ui.buttons.writeMe}</a>
	</div>
</section>

<script>
	document.querySelectorAll("[data-block='examples-tabs']").forEach((root) => {
		const tabs = [...root.querySelectorAll("[data-example-tab]")];
		const panels = [...root.querySelectorAll("[data-example-panel]")];

		function show(index: string | null) {
			tabs.forEach((tab) => {
				const on = tab.getAttribute("data-example-tab") === String(index);
				tab.setAttribute("aria-selected", on ? "true" : "false");
				tab.classList.toggle("bg-primary", on);
				tab.classList.toggle("text-primary-contrast", on);
				tab.classList.toggle("border", !on);
				tab.classList.toggle("border-border", !on);
				tab.classList.toggle("text-text", !on);
			});
			panels.forEach((panel) => {
				const on = panel.getAttribute("data-example-panel") === String(index);
				if (panel instanceof HTMLElement) panel.hidden = !on;
			});
		}

		tabs.forEach((tab) => {
			tab.addEventListener("click", () => show(tab.getAttribute("data-example-tab")));
		});

		root.querySelector("[role='tablist']")?.addEventListener("keydown", (event) => {
			if (!(event instanceof KeyboardEvent)) return;
			if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
			const current = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
			const step = event.key === "ArrowRight" ? 1 : -1;
			const next = tabs[(current + step + tabs.length) % tabs.length];
			if (!(next instanceof HTMLElement)) return;
			event.preventDefault();
			show(next.getAttribute("data-example-tab"));
			next.focus();
		});
	});
</script>
