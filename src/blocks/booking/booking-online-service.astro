---
import type { Locale, SiteConfig } from "../../config/types";
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

interface Props {
	title: string;
	text: string;
	serviceName: string;
	url: string;
	phone: string;
	lead?: string;
	points?: string[];
	note?: string;
	contacts?: SiteConfig["contacts"];
	locale?: Locale;
	/** card — картка з рамкою. band — широка смуга на фоні primary. */
	variant?: "card" | "band";
}

const { title, text, serviceName, url, phone, lead, points, note, contacts, locale = "uk", variant = "card" } = Astro.props;
const band = variant === "band";
const ui = getUi(locale);
const intro = lead || text;
const list = (points ?? []).slice(0, 4).filter((point) => point.trim() !== "");
const serviceLabel = serviceName.trim();
const showService = serviceLabel !== "" && serviceLabel !== "[ЗАПОВНИТИ]" && serviceLabel !== "ЗАПОВНИТИ";
const realUrl = /^https?:\/\//.test(url);
const tel = `tel:${phone.replace(/[^\d+]/g, "")}`;

function handle(value: string) {
	return value.replace(/^@/, "");
}

const messengers = [
	contacts?.telegram
		? { id: "telegram" as const, href: `https://t.me/${handle(contacts.telegram)}` }
		: null,
	contacts?.instagram
		? { id: "instagram" as const, href: `https://instagram.com/${handle(contacts.instagram)}` }
		: null,
].filter((item) => item !== null);
---

<section id="booking" data-block="booking-online-service" data-variant={variant} class="scroll-mt-24">
	<div
		class:list={[
			"mx-auto max-w-6xl min-w-0 px-4 py-12 xl:px-8",
			band ? "" : "grid items-start gap-8 md:grid-cols-12 md:gap-x-10",
		]}
	>
		<div
			class:list={[
				band &&
					"grid items-start gap-8 rounded-theme bg-primary p-7 text-primary-contrast md:grid-cols-12 md:gap-x-10 md:p-12",
				!band && "contents",
			]}
		>
		<div class="min-w-0 md:col-span-7">
			<h2 class:list={["text-3xl", band && "text-primary-contrast"]}>{typograf(title)}</h2>
			{
				intro && (
					<p
						class:list={[
							"mt-3 font-body text-base leading-relaxed",
							band ? "band-soft" : "text-muted",
						]}
					>
						{typograf(intro)}
					</p>
				)
			}
			{
				list.length > 0 && (
					<ul class="mt-6 flex list-none flex-col gap-3 p-0">
						{list.map((point) => (
							<li class="flex items-start gap-3">
								<svg
									class:list={["mt-0.5 h-5 w-5 shrink-0", band ? "text-primary-contrast" : "text-primary"]}
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									aria-hidden="true"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
									/>
								</svg>
								<span
									class:list={[
										"min-w-0 font-body text-[15px] leading-snug",
										band && "text-primary-contrast",
									]}
								>
									{typograf(point)}
								</span>
							</li>
						))}
					</ul>
				)
			}
		</div>
		<div class="min-w-0 md:col-span-5">
			<div class:list={[band ? "" : "rounded-theme border border-border bg-surface p-6"]}>
				<a
					href={realUrl ? url : "#"}
					data-demo-booking
					class:list={[
						"inline-flex w-full items-center justify-center rounded-theme px-6 text-center font-body text-lg",
						band
							? "min-h-14 bg-primary-contrast text-primary"
							: "min-h-14 bg-primary text-primary-contrast",
					]}
					{...(realUrl ? { target: "_blank", rel: "noopener" } : {})}
				>
					{ui.booking.online}
				</a>
				{
					showService && (
						<p class:list={["mt-3 font-body text-sm", band ? "band-soft" : "text-center text-muted"]}>
							{ui.booking.via.replace("{name}", serviceLabel)}
						</p>
					)
				}
				{note && (
					<p class:list={["font-body text-sm", band ? "band-soft mt-3" : "mt-2 text-center text-muted"]}>
						{typograf(note)}
					</p>
				)}
				<div class="mt-6 flex items-center gap-3">
					<span
						class:list={["h-px min-w-0 flex-1", band ? "bg-primary-contrast/40" : "bg-border"]}
						aria-hidden="true"
					></span>
					<span class:list={["font-body text-sm", band ? "band-soft" : "text-muted"]}>{ui.booking.or}</span>
					<span
						class:list={["h-px min-w-0 flex-1", band ? "bg-primary-contrast/40" : "bg-border"]}
						aria-hidden="true"
					></span>
				</div>
				<div
					class:list={[
						"mt-4 flex flex-wrap items-center gap-x-5 gap-y-1",
						band ? "justify-start" : "justify-center",
					]}
				>
					<a
						href={tel}
						class:list={[
							"inline-flex min-h-11 items-center font-body text-[15px]",
							band
								? "text-primary-contrast underline decoration-1 underline-offset-2"
								: "text-primary",
						]}
					>
						{phone}
					</a>
					{
						messengers.map((item) => (
							<a
								href={item.href}
								data-messenger={item.id}
								class:list={[
									"inline-flex min-h-11 items-center font-body text-[15px]",
									band
										? "text-primary-contrast underline decoration-1 underline-offset-2"
										: "text-primary",
								]}
							>
								{ui.messengers[item.id]}
							</a>
						))
					}
				</div>
			</div>
		</div>
		</div>
	</div>
</section>

<style>
	.band-soft {
		color: color-mix(in srgb, var(--color-primary-contrast) 60%, transparent);
	}

	[data-variant="band"] :focus-visible {
		outline: 2px solid var(--color-primary-contrast);
		outline-offset: 2px;
	}
</style>
