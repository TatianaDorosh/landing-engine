---
interface Props {
	label: string;
	ratio?: string;
}

const { label, ratio = "4/3" } = Astro.props;
const safeRatio = /^\d+\/\d+$/.test(ratio) ? ratio : "4/3";
---

<div
	class="flex items-center justify-center bg-border px-4 text-center text-sm text-muted"
	style={`aspect-ratio: ${safeRatio}`}
>
	{label}
</div>
