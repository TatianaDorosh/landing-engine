---
import { typograf } from "../../lib/typograf";

interface Step {
	title: string;
	text: string;
}

interface Props {
	title: string;
	items: Step[];
	/** Короткий абзац під заголовком. Якщо не передано — список як раніше. */
	intro?: string;
	note?: string;
	cta?: { label: string; href: string };
	/** Номер кроку від 1. Якщо не передали, усі кроки однакові. */
	highlightStep?: number;
	/** З якої ширини кроки стають колонками. За замовчуванням lg, як раніше. */
	trackFrom?: "xl" | "lg";
}

const { title, items, intro, note, cta, highlightStep, trackFrom = "lg" } = Astro.props;
const highlightIndex =
	typeof highlightStep === "number" && highlightStep >= 1 && highlightStep <= items.length
		? highlightStep - 1
		: -1;
const columnsFromXl = trackFrom === "xl";
---

<section id="steps" data-block="steps-visit">
	<div class="mx-auto max-w-6xl px-4 py-12 xl:px-8">
		<h2 class="text-3xl">{typograf(title)}</h2>
		{
			intro && (
				<p class="mt-4 max-w-[760px] font-body text-base leading-relaxed">{typograf(intro)}</p>
			)
		}
		<ol
			class:list={[
				"mt-8 flex list-none flex-col gap-6 p-0",
				columnsFromXl ? "xl:grid xl:gap-6" : "lg:grid lg:gap-6",
				!columnsFromXl && (items.length === 5 ? "lg:grid-cols-5" : "lg:grid-cols-4"),
				columnsFromXl && (items.length === 5 ? "xl:grid-cols-5" : "xl:grid-cols-4"),
			]}
		>
			{
				items.map((item, index) => {
					const highlighted = index === highlightIndex;
					return (
						<li
							class:list={[
								"relative flex min-w-0 items-start gap-4",
								columnsFromXl ? "xl:h-full xl:flex-col xl:gap-3" : "lg:flex-col lg:gap-3",
							]}
						>
							{index < items.length - 1 && (
								<span
									class:list={[
										"absolute bottom-[-24px] left-[21px] top-11 w-px bg-border",
										columnsFromXl
											? "xl:bottom-auto xl:left-11 xl:top-[22px] xl:h-px xl:w-[calc(100%-1.25rem)] xl:-translate-y-1/2"
											: "lg:bottom-auto lg:left-11 lg:top-[22px] lg:h-px lg:w-[calc(100%-1.25rem)] lg:-translate-y-1/2",
									]}
									aria-hidden="true"
								></span>
							)}
							<span
								class:list={[
									"relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full font-body text-lg font-semibold",
									highlighted
										? "bg-primary text-primary-contrast"
										: "border-2 border-primary bg-bg text-primary",
								]}
							>
								{index + 1}
							</span>
							<div class="min-w-0">
								<h3 class="font-body text-lg font-semibold text-text">
									{typograf(item.title)}
								</h3>
								<p class="mt-1 font-body text-[15px] leading-[1.5] text-muted">{item.text}</p>
							</div>
						</li>
					);
				})
			}
		</ol>
		{
			note && (
				<p class="mt-6 max-w-[760px] font-body text-[15px] leading-[1.5] text-muted">{typograf(note)}</p>
			)
		}
		{
			cta && (
				<a
					href={cta.href}
					class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-theme border border-primary px-5 text-primary lg:w-auto"
				>
					{cta.label}
				</a>
			)
		}
	</div>
</section>
