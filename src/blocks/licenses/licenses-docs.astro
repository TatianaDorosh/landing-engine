---
import CertificatesDialog from "../../components/CertificatesDialog.astro";
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

interface DocumentImage {
	src: string;
	alt: string;
}

interface DocumentItem {
	kind: "license" | "diploma" | "certificate";
	title: string;
	caption: string;
	image?: DocumentImage;
}

interface Props {
	title: string;
	intro: string;
	documents: DocumentItem[];
	sterilization: { title: string; points: string[] };
}

// Велике фото відкриває CertificatesDialog (view="single"): той самий скрипт, Esc і фокус назад на картку.
const { title, intro, documents, sterilization } = Astro.props;
const ui = getUi("uk");
const dialogItems = documents.map((doc) => ({
	name: doc.title,
	certificates: [
		{
			label: doc.caption,
			...(doc.image?.src && doc.image.alt
				? { image: { src: doc.image.src, alt: doc.image.alt } }
				: {}),
		},
	],
}));
---

<section id="licenses" data-block="licenses-docs">
	<div class="mx-auto grid max-w-6xl items-start gap-8 px-4 py-12 lg:grid-cols-12 lg:gap-x-10 lg:px-8">
		<div class="min-w-0 lg:col-span-5">
			<h2 class="text-3xl">{typograf(title)}</h2>
			<p class="mt-4 max-w-[760px] font-body text-base leading-relaxed">{typograf(intro)}</p>
		</div>
		<ul class="grid list-none grid-cols-1 gap-4 p-0 lg:col-span-7 lg:grid-cols-2">
			{
				documents.map((doc, index) => {
					const photo = doc.image?.src && doc.image.alt ? doc.image : undefined;
					return (
						<li class="h-full min-w-0">
							<button
								type="button"
								data-certs-open={index}
								data-kind={doc.kind}
								aria-haspopup="dialog"
								class="flex h-full w-full min-h-11 flex-col overflow-hidden rounded-theme border border-border bg-surface text-left"
							>
								<span class="sr-only">{ui.licenses.open}: </span>
								<div class="relative aspect-[4/3] w-full shrink-0">
									{photo ? (
										<img
											src={photo.src}
											alt={photo.alt}
											loading="lazy"
											decoding="async"
											class="absolute inset-0 h-full w-full object-cover"
										/>
									) : (
										<PhotoPlaceholder label={doc.caption} class="absolute inset-0 h-full" />
									)}
								</div>
								<div class="flex flex-1 flex-col p-5">
									<h3 class="font-body text-[17px] font-semibold leading-snug">{typograf(doc.title)}</h3>
									<p class="mt-auto pt-2 font-body text-[15px] leading-[1.5] text-muted">{typograf(doc.caption)}</p>
								</div>
							</button>
						</li>
					);
				})
			}
			<li class="h-full min-w-0">
				<article class="flex h-full flex-col rounded-theme border border-border bg-surface p-5">
					<h3 class="font-body text-[17px] font-semibold leading-snug">{typograf(sterilization.title)}</h3>
					<ul class="mt-4 flex list-none flex-col gap-3 p-0">
						{
							sterilization.points.map((point) => (
								<li class="flex items-start gap-3">
									<span class="mt-0.5 shrink-0 font-body text-[15px] font-semibold text-primary" aria-hidden="true">
										✓
									</span>
									<span class="min-w-0 font-body text-[15px] leading-[1.5]">{typograf(point)}</span>
								</li>
							))
						}
					</ul>
				</article>
			</li>
		</ul>
	</div>
	<CertificatesDialog view="single" items={dialogItems} />
</section>
