---
import Base from "../layouts/Base.astro";
import Header from "../blocks/layout/layout-header.astro";
import Hero from "../blocks/hero/hero-result.astro";
import HeroShowcase from "../blocks/hero/hero-showcase.astro";
import HeroCover from "../blocks/hero/hero-cover.astro";
import AboutMe from "../blocks/about/about-me.astro";
import PricesSimple from "../blocks/prices/prices-simple.astro";
import BookingMessengers from "../blocks/booking/booking-messengers.astro";
import Trust from "../blocks/trust/trust-strip.astro";
import Services from "../blocks/services/services-cards.astro";
import ServicesScope from "../blocks/services/services-scope.astro";
import ExamplesTabs from "../blocks/examples/examples-tabs.astro";
import PainsTable from "../blocks/pains/pains-table.astro";
import PricesPackages from "../blocks/prices/prices-packages.astro";
import Effects from "../blocks/effects/effects-cards.astro";
import Safety from "../blocks/safety/safety-standards.astro";
import UrgentToday from "../blocks/urgent/urgent-today.astro";
import AnesthesiaComfort from "../blocks/anesthesia/anesthesia-comfort.astro";
import LicensesDocs from "../blocks/licenses/licenses-docs.astro";
import Gallery from "../blocks/gallery/gallery-carousel.astro";
import BeforeAfter from "../blocks/gallery/gallery-before-after.astro";
import Prices from "../blocks/prices/prices-levels.astro";
import TeamCards from "../blocks/team/team-cards.astro";
import TeamCompact from "../blocks/team/team-compact.astro";
import Steps from "../blocks/steps/steps-visit.astro";
import RulesList from "../blocks/rules/rules-list.astro";
import Reviews from "../blocks/reviews/reviews-cards.astro";
import Gifts from "../blocks/gifts/gifts-certificates.astro";
import Booking from "../blocks/booking/booking-form.astro";
import BookingCta from "../blocks/booking/booking-cta.astro";
import BookingDrawer from "../blocks/booking/booking-drawer.astro";
import BookingOnline from "../blocks/booking/booking-online-service.astro";
import Faq from "../blocks/faq/faq-accordion.astro";
import Myths from "../blocks/faq/faq-myths.astro";
import FaqSplit from "../blocks/faq/faq-split.astro";
import ContactsMap from "../blocks/contacts/contacts-map.astro";
import Messengers from "../blocks/layout/layout-messengers.astro";
import Footer from "../blocks/layout/layout-footer.astro";
import { demoBeauty } from "../config/demo-beauty";
import { portfolio } from "../config/portfolio";
import { demoMokka } from "../config/demo-mokka";
import { getUi } from "../i18n";
import { header, hero, trust, services, safety, gallery, beforeAfter, prices, team, steps, reviews, gifts, booking, faq, myths, contacts } from "../data/demo-beauty";
import { urgentToday, anesthesiaComfort, licensesDocs } from "../data/demo-dental";
import { hero as mokkaHero, about as mokkaAbout, prices as mokkaPrices, booking as mokkaBooking } from "../data/demo-mokka";
import { demoSlate } from "../config/demo-slate";
import { effects, myths as slateMyths, booking as slateBooking, reviews as slateReviews } from "../data/demo-slate";
import { hero as portfolioHero, services as portfolioServices, examples, examplesCount, pains, packages } from "../data/portfolio";

const ui = getUi(demoBeauty.locale);

const rules = {
	title: "Правила запису",
	intro: "Час у студії заброньований особисто для вас. Коротко про те, як ми його тримаємо.",
	items: [
		{
			title: "Передоплата",
			text: "Щоб час був за вами, потрібна передоплата. Вона входить у вартість візиту, а не додається зверху.",
		},
		{
			title: "Запізнення",
			text: "Якщо запізнюєтесь більше ніж на 15 хвилин, візит скорочуємо або переносимо: наступний запис уже стоїть.",
		},
		{
			title: "Перенесення",
			text: "Перенести або скасувати запис можна не пізніше ніж за добу. Якщо пізніше, передоплата не повертається.",
		},
		{
			title: "Гарантія",
			text: "Якщо покриття скололось не з вашої вини протягом тижня, переробимо безкоштовно.",
		},
	],
};
---

<Base config={demoBeauty} noindex={true} title="Вітрина блоків landing-engine">
	<div data-vitrina>
	<div class="mx-auto max-w-6xl px-4 pb-4 pt-8 xl:px-8">
		<h1 class="text-3xl">Вітрина блоків</h1>
	</div>

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">layout-header</p>
	<Header {...header} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">hero-result</p>
	<Hero {...hero} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">hero-showcase</p>
	<HeroShowcase {...portfolioHero} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">hero-cover</p>
	<HeroCover {...mokkaHero} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">about-me</p>
	<AboutMe {...mokkaAbout} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">prices-simple</p>
	<PricesSimple {...mokkaPrices} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">booking-messengers</p>
	<BookingMessengers {...mokkaBooking} contacts={demoMokka.contacts} locale={demoMokka.locale} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">trust-strip</p>
	<Trust {...trust} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">services-cards</p>
	<Services {...services} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">services-scope</p>
	<ServicesScope {...portfolioServices} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">examples-tabs</p>
	<ExamplesTabs {...examples} count={examplesCount} locale={portfolio.locale} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">pains-table</p>
	<PainsTable {...pains} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">prices-packages</p>
	<PricesPackages {...packages} locale={portfolio.locale} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">effects-cards</p>
	<Effects {...effects} locale={demoBeauty.locale} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">safety-standards</p>
	<Safety {...safety} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">urgent-today</p>
	<UrgentToday {...urgentToday} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">anesthesia-comfort</p>
	<AnesthesiaComfort {...anesthesiaComfort} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">licenses-docs</p>
	<LicensesDocs {...licensesDocs} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">gallery-carousel</p>
	<Gallery {...gallery} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">gallery-before-after</p>
	<BeforeAfter {...beforeAfter} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">prices-levels</p>
	<Prices {...prices} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">team-cards</p>
	<TeamCards {...team} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">team-compact</p>
	<TeamCompact {...team} bookLabel={ui.buttons.book} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">steps-visit</p>
	<Steps {...steps} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">rules-list</p>
	<RulesList {...rules} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">reviews-cards</p>
	<Reviews {...reviews} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">reviews-cards / open</p>
	<Reviews {...slateReviews} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">gifts-certificates</p>
	<Gifts {...gifts} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">booking-form</p>
	<Booking {...booking} config={demoBeauty} sectionId="booking-form" />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">booking-cta</p>
	<BookingCta
		title={booking.ctaTitle}
		text={booking.ctaText}
		writeLabel={booking.writeLabel}
		ctaLabel={booking.ctaLabel}
		config={demoBeauty}
	/>

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">booking-drawer</p>
	<div class="mx-auto max-w-6xl px-4 pb-8 xl:px-8">
		<a href="#booking" class="inline-flex min-h-11 items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast">
			Відкрити панель запису
		</a>
	</div>
	<BookingDrawer
		title={booking.title}
		note="Підтвердимо запис у месенджері протягом 15 хвилин у робочий час"
		services={booking.services}
		masters={booking.masters}
		privacyHref={booking.privacyHref}
		config={demoBeauty}
	/>

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">booking-online-service</p>
	<BookingOnline
		{...slateBooking}
		variant="card"
		phone={demoSlate.contacts.phoneDisplay ?? demoSlate.contacts.phone}
		contacts={demoSlate.contacts}
		locale={demoSlate.locale}
	/>

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">booking-online-service / band</p>
	<BookingOnline
		{...slateBooking}
		phone={demoSlate.contacts.phoneDisplay ?? demoSlate.contacts.phone}
		contacts={demoSlate.contacts}
		locale={demoSlate.locale}
	/>

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">faq-accordion</p>
	<Faq {...faq} telegram={demoBeauty.contacts.telegram} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">faq-myths</p>
	<Myths {...myths} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">faq-split</p>
	<FaqSplit {...slateMyths} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">contacts-map</p>
	<ContactsMap {...contacts} contacts={demoBeauty.contacts} />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">layout-messengers</p>
	<Messengers config={demoBeauty} alwaysVisible />

	<p class="mx-auto max-w-6xl border-t border-border px-4 pt-3 text-sm text-muted xl:px-8">layout-footer</p>
	<Footer config={demoBeauty} privacyHref="/flagship-beauty/privacy/" />
	</div>
</Base>

<style is:global>
	/* Лише вітрина. Карусель лишається свайпом у своєму рядку, сторінка не ширшає. */
	@media (width < 80rem) {
		[data-vitrina] [data-block="gallery-carousel"] > div:first-child,
		[data-vitrina] [data-block="team-cards"] > div:first-child,
		[data-vitrina] [data-block="reviews-cards"]:not([data-variant="open"]) > div:first-child {
			min-width: 0;
			max-width: 100%;
			overflow-x: clip;
		}

		[data-vitrina] [data-block="gallery-carousel"] [data-track],
		[data-vitrina] [data-block="team-cards"] [data-track],
		[data-vitrina] [data-block="reviews-cards"]:not([data-variant="open"]) [data-track] {
			min-width: 0;
			max-width: 100%;
			overflow-x: auto;
		}

		[data-vitrina] [data-block="gallery-carousel"] [data-slide],
		[data-vitrina] [data-block="team-cards"] [data-slide],
		[data-vitrina] [data-block="reviews-cards"]:not([data-variant="open"]) [data-slide] {
			min-width: 0;
			max-width: 85%;
		}
	}
</style>
