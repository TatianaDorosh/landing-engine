---
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

interface Props {
	text: string;
	note?: string;
	phone: { label: string; href: string };
	cta?: { label?: string; href?: string };
	/** false — без кнопки запису. Без пропса кнопка є, як раніше. */
	showBook?: boolean;
	/** centered — один рядок по центру, номер як посилання. Без пропса вигляд як раніше. */
	layout?: "centered";
}

// Текст про вільні місця задає власник у props (text).
// Блок не перевіряє розклад і не показує живу доступність.
const { text, note, phone, cta, showBook = true, layout } = Astro.props;
const ui = getUi("uk");
const callLabel = ui.urgent.call;
const bookLabel = cta?.label || ui.urgent.book;
const bookHref = cta?.href || "#booking";
const centered = layout === "centered";
const lineText = typograf(text);
const lineNote = note ? typograf(note) : "";
---

{
	centered ? (
		<section
			id="urgent"
			data-block="urgent-today"
			data-layout="centered"
			class="bg-primary text-primary-contrast"
		>
			<div class="mx-auto flex max-w-6xl flex-col items-center justify-center gap-1.5 px-4 py-3.5 text-center sm:min-h-[58px] sm:flex-row sm:gap-0 sm:py-4">
				<p class="flex max-w-full flex-col items-center justify-center font-body text-[15px] font-medium leading-snug sm:flex-row sm:flex-nowrap sm:text-base sm:leading-6">
					<span>{lineText}</span>
					{
						lineNote && (
							<>
								<span class="urgent-rule" aria-hidden="true"></span>
								<span>{lineNote}</span>
							</>
						)
					}
				</p>
				<span class="urgent-rule urgent-rule-phone" aria-hidden="true"></span>
				<a
					href={phone.href}
					class="font-body text-[15px] font-semibold text-primary-contrast underline-offset-2 hover:underline sm:text-base"
				>
					{phone.label}
				</a>
			</div>
		</section>
	) : (
<section id="urgent" data-block="urgent-today" class="bg-primary text-primary-contrast">
	<div
		class:list={[
			"mx-auto flex max-w-6xl flex-col gap-3 px-4 py-3 sm:gap-4 sm:py-4 lg:gap-8 lg:px-8 lg:py-5",
			showBook
				? "lg:flex-row lg:items-center lg:justify-between"
				: "sm:flex-row sm:items-center sm:justify-between",
		]}
	>
		<div class="min-w-0">
			<p class="font-body text-base font-semibold leading-snug">{typograf(text)}</p>
			{note && <p class="mt-1 hidden font-body text-[15px] leading-[1.5] sm:block">{typograf(note)}</p>}
		</div>
		<div
			class:list={[
				"flex w-full shrink-0 flex-col gap-2 lg:gap-3",
				showBook ? "lg:w-auto lg:flex-row" : "sm:w-auto",
			]}
		>
			<a
				href={phone.href}
				aria-label={`${callLabel} ${phone.label}`}
				class:list={[
					"inline-flex min-h-11 w-full flex-wrap items-center justify-center gap-x-2 rounded-theme bg-primary-contrast px-5 text-center font-body text-[15px] font-semibold text-primary",
					showBook ? "lg:w-auto" : "sm:w-auto",
				]}
			>
				{callLabel}
				<span>{phone.label}</span>
			</a>
			{
				showBook && (
					<a
						href={bookHref}
						class="hidden min-h-11 w-full items-center justify-center rounded-theme border border-primary-contrast bg-transparent px-5 text-center font-body text-[15px] font-semibold text-primary-contrast sm:inline-flex lg:w-auto"
					>
						{bookLabel}
					</a>
				)
			}
		</div>
	</div>
</section>
	)
}

<style is:global>
	[data-block="urgent-today"] a:focus-visible,
	[data-block="urgent-today"] button:focus-visible {
		outline: 2px solid var(--color-primary-contrast);
		outline-offset: 2px;
	}

	[data-block="urgent-today"][data-layout="centered"] .urgent-rule {
		display: none;
		width: 1px;
		height: 16px;
		flex: none;
		background: color-mix(in srgb, var(--color-primary-contrast) 35%, transparent);
	}

	@media (width >= 640px) {
		[data-block="urgent-today"][data-layout="centered"] .urgent-rule {
			display: inline-block;
			margin-inline: 24px;
		}
	}
</style>
