---
import { typograf } from "../../lib/typograf";

interface Props {
	title: string;
	text: string;
	serviceName: string;
	url: string;
	phone: string;
}

const { title, text, serviceName, url, phone } = Astro.props;
---

<section id="booking" data-block="booking-online-service" class="scroll-mt-24">
	<div class="mx-auto max-w-6xl px-4 py-12 xl:px-8">
		<h2 class="text-3xl">{typograf(title)}</h2>
		<div class="mt-6 max-w-xl rounded-theme border border-border bg-surface p-6">
			<p class="font-body text-[15px] leading-[1.6] xl:text-base">{text}</p>
			<a
				href={url}
				target="_blank"
				rel="noopener"
				class="mt-6 inline-flex min-h-14 w-full items-center justify-center rounded-theme bg-primary px-6 font-body text-lg text-primary-contrast sm:w-auto"
			>
				Записатися в {serviceName}
			</a>
			<p class="mt-4 font-body text-[15px] text-muted">
				або зателефонуйте
				<a href={`tel:${phone}`} class="inline-flex min-h-11 items-center text-primary">{phone}</a>
			</p>
		</div>
	</div>
</section>
