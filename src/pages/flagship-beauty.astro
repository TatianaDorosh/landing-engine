---
import Base from "../layouts/Base.astro";
import Header from "../blocks/layout/layout-header.astro";
import Hero from "../blocks/hero/hero-result.astro";
import Trust from "../blocks/trust/trust-strip.astro";
import Services from "../blocks/services/services-cards.astro";
import Safety from "../blocks/safety/safety-standards.astro";
import Gallery from "../blocks/gallery/gallery-carousel.astro";
import BeforeAfter from "../blocks/gallery/gallery-before-after.astro";
import Prices from "../blocks/prices/prices-levels.astro";
import Team from "../blocks/team/team-compact.astro";
import Steps from "../blocks/steps/steps-visit.astro";
import Reviews from "../blocks/reviews/reviews-cards.astro";
import Gifts from "../blocks/gifts/gifts-certificates.astro";
import Faq from "../blocks/faq/faq-accordion.astro";
import Myths from "../blocks/faq/faq-myths.astro";
import ContactsMap from "../blocks/contacts/contacts-map.astro";
import Footer from "../blocks/layout/layout-footer.astro";
import { demoBeauty } from "../config/demo-beauty";
import { getUi } from "../i18n";
import { header, hero, trust, services, safety, gallery, beforeAfter, prices, team, steps, reviews, gifts, faq, myths, contacts } from "../data/demo-beauty";

const ui = getUi(demoBeauty.locale);
---

<Base config={demoBeauty}>
	<Header {...header} />
	<main>
		<Hero {...hero} />
		<Trust {...trust} />
		<Services {...services} />
		<Safety {...safety} />
		<Gallery {...gallery} />
		<BeforeAfter {...beforeAfter} />
		<Prices {...prices} />
		<Team {...team} bookLabel={ui.buttons.book} />
		<Steps {...steps} />
		<Reviews {...reviews} />
		<Gifts {...gifts} />
		<Faq {...faq} telegram={demoBeauty.contacts.telegram} />
		<Myths {...myths} />
		<ContactsMap {...contacts} contacts={demoBeauty.contacts} />
	</main>
	<Footer config={demoBeauty} privacyHref="/flagship-beauty/privacy/" />
</Base>
