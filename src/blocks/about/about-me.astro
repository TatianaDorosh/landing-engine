---
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { typograf } from "../../lib/typograf";

interface Props {
	title: string;
	paragraphs: string[];
	facts: string[];
	signature: string;
	/** Підпис на заглушці фото. Якщо не передано, береться заголовок. Порожній рядок ховає текст. */
	imageLabel?: string;
	image?: { src: string; alt: string; position?: string };
}

const { title, paragraphs, facts, signature, imageLabel, image } = Astro.props;
const photoLabel = imageLabel ?? title;
---

<section id="about" data-block="about-me" class="bg-surface">
	<div class="mx-auto grid max-w-6xl min-w-0 items-stretch gap-8 px-4 py-12 lg:grid-cols-12 lg:gap-x-10 xl:px-8">
		<div class="relative aspect-[3/4] min-w-0 overflow-hidden rounded-theme lg:col-span-5 lg:aspect-auto lg:h-full lg:min-h-[320px]">
			{
				image ? (
					<img
						src={image.src}
						alt={image.alt}
						loading="lazy"
						decoding="async"
						class="absolute inset-0 h-full w-full object-cover"
						style={image.position ? `object-position: ${image.position}` : undefined}
					/>
				) : (
					<PhotoPlaceholder label={photoLabel} class="absolute inset-0 h-full" />
				)
			}
		</div>
		<div class="min-w-0 lg:col-span-7">
			<h2 class="text-3xl">{typograf(title)}</h2>
			<div class="mt-4 space-y-4">
				{
					paragraphs.map((paragraph) => (
						<p class="font-body text-base leading-relaxed">{typograf(paragraph)}</p>
					))
				}
			</div>
			<ul class="mt-6 flex list-none flex-col gap-3 p-0">
				{
					facts.map((fact) => (
						<li class="flex min-w-0 items-start gap-3">
							<span class="mt-1 h-4 w-0.5 shrink-0 bg-accent" aria-hidden="true"></span>
							<span class="min-w-0 font-body text-[15px] leading-[1.5]">{typograf(fact)}</span>
						</li>
					))
				}
			</ul>
			<p class="mt-8 font-heading text-[28px] leading-none">{signature}</p>
		</div>
	</div>
</section>
