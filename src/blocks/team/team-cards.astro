---
import CertificatesDialog from "../../components/CertificatesDialog.astro";
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

interface Certificate {
	label: string;
	image?: { src: string; alt: string };
}

interface Member {
	name: string;
	role: string;
	details: string;
	image?: { src: string; alt: string; width: number; height: number };
	imageLabel?: string;
	certificates?: Certificate[];
	bookingHref?: string;
}

interface Props {
	title: string;
	items: Member[];
	bookLabel?: string;
	/** fit — три картки в ряд від 640px. Без пропса лишається карусель. */
	layout?: "carousel" | "fit";
	/** dots — крапки замість смуги прокрутки, лише коли стрічка гортається. */
	indicator?: "dots";
}

const {
	title,
	items,
	bookLabel = getUi("uk").buttons.book,
	layout = "carousel",
	indicator,
} = Astro.props;
const fit = layout === "fit";
const dotNav = indicator === "dots";
---

<section id="team" data-block="team-cards">
	<div class="mx-auto max-w-6xl px-4 py-12 xl:px-8">
		<h2 class="text-3xl">{typograf(title)}</h2>
		<div
			data-track
			data-indicator={dotNav ? "dots" : undefined}
			tabindex="0"
			role="region"
			aria-label="Майстри"
			class:list={[
				fit
					? "mt-6 flex w-full min-w-0 snap-x snap-mandatory gap-6 overflow-x-auto overflow-y-hidden sm:grid sm:snap-none sm:justify-start sm:overflow-x-visible sm:overflow-y-visible sm:[grid-template-columns:repeat(3,minmax(0,320px))]"
					: "mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto xl:grid xl:grid-cols-3 xl:overflow-visible",
			]}
		>
			{
				items.map((item, index) => (
					<article
						data-slide
						class:list={[
							"flex shrink-0 flex-col overflow-hidden rounded-theme border border-border bg-surface",
							fit
								? "w-60 snap-start sm:w-auto sm:min-w-0 sm:max-w-[320px]"
								: "w-[85%] snap-center xl:w-auto",
						]}
					>
						<div class:list={["aspect-[4/5] w-full overflow-hidden", !fit && "xl:max-h-[360px]"]}>
							{item.image ? (
								<img
									src={item.image.src}
									alt={item.image.alt}
									width={item.image.width}
									height={item.image.height}
									loading="lazy"
									decoding="async"
									class:list={[
										"h-full w-full object-cover",
										fit ? "object-[50%_15%]" : "object-[center_20%]",
									]}
								/>
							) : (
								<PhotoPlaceholder label={item.imageLabel ?? item.name} class="h-full" />
							)}
						</div>
						<div class="flex flex-1 flex-col p-4">
							<h3 class="font-body text-2xl font-semibold">{typograf(item.name)}</h3>
							<p class="mt-1 font-body text-[15px] leading-[1.5] text-muted">{item.role}</p>
							<p class="mt-1 font-body text-[15px] leading-[1.5] text-muted">{item.details}</p>
							<div class="mt-auto flex items-center justify-between gap-3 pt-4">
								{item.certificates && item.certificates.length > 0 && (
									<button
										type="button"
										data-certs-open={index}
										class="inline-flex min-h-11 items-center text-primary"
										aria-haspopup="dialog"
									>
										Сертифікати
									</button>
								)}
								<a
									href={item.bookingHref ?? "#booking"}
									data-master={item.name}
									class="ml-auto inline-flex min-h-11 items-center text-[15px] font-semibold text-primary"
								>
									{bookLabel} →
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>
		{
			!fit && !dotNav && (
				<div data-dots class="mt-2 flex justify-center xl:hidden" aria-label="Майстри"></div>
			)
		}
		{
			dotNav && (
				<div data-dotnav>
					{items.map((_, index) => (
						<button
							type="button"
							data-dot={index}
							aria-label={`Лікар ${index + 1} з ${items.length}`}
							aria-current={index === 0 ? "true" : undefined}
						>
							<span></span>
						</button>
					))}
				</div>
			)
		}
	</div>
	<CertificatesDialog items={items} />
</section>

<script>
	document.querySelectorAll("[data-block='team-cards']").forEach((root) => {
		const track = root.querySelector("[data-track]");
		const dots = root.querySelector("[data-dots]");
		if (!track || !dots) return;

		const slides = () => [...root.querySelectorAll("[data-slide]")];

		function setActiveDot(active) {
			[...dots.querySelectorAll("[data-dot]")].forEach((dot, i) => {
				const mark = dot.querySelector("span");
				const on = i === active;
				dot.setAttribute("aria-current", on ? "true" : "false");
				mark?.classList.toggle("bg-primary", on);
				mark?.classList.toggle("bg-border", !on);
			});
		}

		slides().forEach((_, i) => {
			const dot = document.createElement("button");
			dot.type = "button";
			dot.dataset.dot = String(i);
			dot.className = "inline-flex min-h-11 min-w-11 items-center justify-center";
			dot.setAttribute("aria-label", `Майстер ${i + 1}`);
			const mark = document.createElement("span");
			mark.className = "h-2.5 w-2.5 rounded-full bg-border";
			dot.append(mark);
			dots.append(dot);
		});
		setActiveDot(0);

		if ("IntersectionObserver" in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					if (window.matchMedia("(min-width: 1280px)").matches) return;
					const visible = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
					if (!visible) return;
					setActiveDot(slides().indexOf(visible.target));
				},
				{ root: track, threshold: [0.55, 0.75] },
			);
			slides().forEach((slide) => observer.observe(slide));
		}

		dots.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const dot = target.closest("[data-dot]");
			if (!dot) return;
			slides()[Number(dot.getAttribute("data-dot"))]?.scrollIntoView({
				behavior: "smooth",
				inline: "center",
				block: "nearest",
			});
		});
	});

	document.querySelectorAll("[data-block='team-cards']").forEach((root) => {
		const track = root.querySelector("[data-track][data-indicator='dots']");
		const nav = root.querySelector("[data-dotnav]");
		if (!track || !nav) return;

		const slides = () => [...track.querySelectorAll("[data-slide]")];
		const buttons = () => [...nav.querySelectorAll("[data-dot]")];

		function canScroll() {
			const overflow = getComputedStyle(track).overflowX;
			if (overflow !== "auto" && overflow !== "scroll") return false;
			return track.scrollWidth - track.clientWidth > 1;
		}

		function nearest() {
			const edge = track.getBoundingClientRect().left;
			let index = 0;
			let best = Infinity;
			slides().forEach((slide, i) => {
				const dist = Math.abs(slide.getBoundingClientRect().left - edge);
				if (dist < best) {
					best = dist;
					index = i;
				}
			});
			return index;
		}

		function setActive(index) {
			buttons().forEach((button, i) => {
				if (i === index) button.setAttribute("aria-current", "true");
				else button.removeAttribute("aria-current");
			});
		}

		function refresh() {
			if (canScroll()) {
				nav.setAttribute("data-on", "");
				setActive(nearest());
			} else {
				nav.removeAttribute("data-on");
			}
		}

		nav.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const button = target.closest("[data-dot]");
			if (!button || !nav.contains(button)) return;
			slides()[Number(button.getAttribute("data-dot"))]?.scrollIntoView({
				behavior: "smooth",
				inline: "start",
				block: "nearest",
			});
		});

		track.addEventListener(
			"scroll",
			() => {
				if (nav.hasAttribute("data-on")) setActive(nearest());
			},
			{ passive: true },
		);

		refresh();
		if ("ResizeObserver" in window) new ResizeObserver(refresh).observe(track);
	});
</script>

<style>
	[data-track][data-indicator="dots"] {
		scrollbar-width: none;
	}
	[data-track][data-indicator="dots"]::-webkit-scrollbar {
		display: none;
		height: 0;
	}
	[data-dotnav] {
		display: none;
		justify-content: center;
		margin-top: 8px;
	}
	[data-dotnav][data-on] {
		display: flex;
	}
	[data-dotnav] [data-dot] {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		margin-inline: -4px;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
	}
	[data-dotnav] [data-dot] span {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-primary) 35%, transparent);
	}
	[data-dotnav] [data-dot][aria-current="true"] span {
		background: var(--color-primary);
	}
</style>
