---
import Base from "../layouts/Base.astro";
import Header from "../blocks/layout/layout-header.astro";
import HeroCover from "../blocks/hero/hero-cover.astro";
import ContactsMap from "../blocks/contacts/contacts-map.astro";
import Footer from "../blocks/layout/layout-footer.astro";
import { demoMokka } from "../config/demo-mokka";
import { header, hero, contacts } from "../data/demo-mokka";
---

<Base config={demoMokka}>
	<Header {...header} nameHref="/template-massage/" />
	<main>
		<HeroCover {...hero} />
		<ContactsMap {...contacts} contacts={demoMokka.contacts} />
	</main>
	<Footer config={demoMokka} privacyHref="/template-massage/privacy/" />
</Base>
