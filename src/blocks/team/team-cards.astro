---
import CertificatesDialog from "../../components/CertificatesDialog.astro";
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { getUi } from "../../i18n";
import { typograf } from "../../lib/typograf";

interface Certificate {
	label: string;
	image?: { src: string; alt: string };
}

interface Member {
	name: string;
	role: string;
	details: string;
	image?: { src: string; alt: string; width: number; height: number };
	imageLabel?: string;
	certificates?: Certificate[];
	bookingHref?: string;
}

interface Props {
	title: string;
	items: Member[];
	bookLabel?: string;
}

const { title, items, bookLabel = getUi("uk").buttons.book } = Astro.props;
---

<section id="team" data-block="team-cards">
	<div class="mx-auto max-w-6xl px-4 py-12 xl:px-8">
		<h2 class="text-3xl">{typograf(title)}</h2>
		<div
			data-track
			tabindex="0"
			role="region"
			aria-label="Майстри"
			class="mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto xl:grid xl:grid-cols-3 xl:overflow-visible"
		>
			{
				items.map((item, index) => (
					<article
						data-slide
						class="flex w-[85%] shrink-0 snap-center flex-col overflow-hidden rounded-theme border border-border bg-surface xl:w-auto"
					>
						<div class="aspect-[4/5] w-full overflow-hidden xl:max-h-[360px]">
							{item.image ? (
								<img
									src={item.image.src}
									alt={item.image.alt}
									width={item.image.width}
									height={item.image.height}
									loading="lazy"
									decoding="async"
									class="h-full w-full object-cover object-[center_20%]"
								/>
							) : (
								<PhotoPlaceholder label={item.imageLabel ?? item.name} class="h-full" />
							)}
						</div>
						<div class="flex flex-1 flex-col p-4">
							<h3 class="font-body text-2xl font-semibold">{typograf(item.name)}</h3>
							<p class="mt-1 font-body text-[15px] leading-[1.5] text-muted">{item.role}</p>
							<p class="mt-1 font-body text-[15px] leading-[1.5] text-muted">{item.details}</p>
							<div class="mt-auto flex items-center justify-between gap-3 pt-4">
								{item.certificates && item.certificates.length > 0 && (
									<button
										type="button"
										data-certs-open={index}
										class="inline-flex min-h-11 items-center text-primary"
										aria-haspopup="dialog"
									>
										Сертифікати
									</button>
								)}
								<a
									href={item.bookingHref ?? "#booking"}
									data-master={item.name}
									class="ml-auto inline-flex min-h-11 items-center text-[15px] font-semibold text-primary"
								>
									{bookLabel} →
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>
		<div data-dots class="mt-2 flex justify-center xl:hidden" aria-label="Майстри"></div>
	</div>
	<CertificatesDialog items={items} />
</section>

<script>
	document.querySelectorAll("[data-block='team-cards']").forEach((root) => {
		const track = root.querySelector("[data-track]");
		const dots = root.querySelector("[data-dots]");
		if (!track || !dots) return;

		const slides = () => [...root.querySelectorAll("[data-slide]")];

		function setActiveDot(active) {
			[...dots.querySelectorAll("[data-dot]")].forEach((dot, i) => {
				const mark = dot.querySelector("span");
				const on = i === active;
				dot.setAttribute("aria-current", on ? "true" : "false");
				mark?.classList.toggle("bg-primary", on);
				mark?.classList.toggle("bg-border", !on);
			});
		}

		slides().forEach((_, i) => {
			const dot = document.createElement("button");
			dot.type = "button";
			dot.dataset.dot = String(i);
			dot.className = "inline-flex min-h-11 min-w-11 items-center justify-center";
			dot.setAttribute("aria-label", `Майстер ${i + 1}`);
			const mark = document.createElement("span");
			mark.className = "h-2.5 w-2.5 rounded-full bg-border";
			dot.append(mark);
			dots.append(dot);
		});
		setActiveDot(0);

		if ("IntersectionObserver" in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					if (window.matchMedia("(min-width: 1280px)").matches) return;
					const visible = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
					if (!visible) return;
					setActiveDot(slides().indexOf(visible.target));
				},
				{ root: track, threshold: [0.55, 0.75] },
			);
			slides().forEach((slide) => observer.observe(slide));
		}

		dots.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const dot = target.closest("[data-dot]");
			if (!dot) return;
			slides()[Number(dot.getAttribute("data-dot"))]?.scrollIntoView({
				behavior: "smooth",
				inline: "center",
				block: "nearest",
			});
		});
	});
</script>
