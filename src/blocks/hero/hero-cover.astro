---
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { typograf } from "../../lib/typograf";

interface Props {
	eyebrow: string;
	title: string;
	text: string;
	cta: { label: string; href: string };
	image?: { src: string; alt: string; position?: string };
}

const { eyebrow, title, text, cta, image } = Astro.props;
---

<section
	id="hero"
	data-block="hero-cover"
	class="relative flex h-[calc(100svh-4.25rem)] items-end overflow-hidden lg:h-[min(90vh,calc(100svh-4.25rem))]"
>
	{
		image ? (
			<img
				src={image.src}
				alt={image.alt}
				loading="eager"
				fetchpriority="high"
				decoding="async"
				class="absolute inset-0 h-full w-full object-cover"
				style={image.position ? `object-position: ${image.position}` : undefined}
			/>
		) : (
			<PhotoPlaceholder label={title} class="absolute inset-0 h-full" />
		)
	}
	<div
		class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg from-10% via-bg/80 via-45% to-transparent"
		aria-hidden="true"
	>
	</div>
	<div class="relative z-10 mx-auto w-full max-w-6xl px-4 pb-8 xl:px-8 xl:pb-12">
		<p class="font-body text-[15px]">{eyebrow}</p>
		<h1 class="mt-3 max-w-3xl font-heading text-[36px] leading-[1.15] lg:text-[56px]">{typograf(title)}</h1>
		<p class="mt-4 max-w-xl font-body text-base leading-relaxed">{text}</p>
		<a
			href={cta.href}
			class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast lg:w-auto"
		>
			{cta.label}
		</a>
	</div>
</section>
