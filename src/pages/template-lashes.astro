---
import Base from "../layouts/Base.astro";
import Header from "../blocks/layout/layout-header.astro";
import Hero from "../blocks/hero/hero-result.astro";
import Effects from "../blocks/effects/effects-cards.astro";
import About from "../blocks/about/about-me.astro";
import Prices from "../blocks/prices/prices-levels.astro";
import Myths from "../blocks/faq/faq-myths.astro";
import Reviews from "../blocks/reviews/reviews-cards.astro";
import BookingOnline from "../blocks/booking/booking-online-service.astro";
import ContactsMap from "../blocks/contacts/contacts-map.astro";
import Footer from "../blocks/layout/layout-footer.astro";
import { demoSlate } from "../config/demo-slate";
import { header, hero, effects, about, prices, myths, reviews, booking, contacts } from "../data/demo-slate";
---

<Base config={demoSlate}>
	<Header {...header} nameHref="/template-lashes/" />
	<main>
		<Hero {...hero} />
		<Effects {...effects} locale={demoSlate.locale} />
		<About {...about} />
		<Prices {...prices} />
		<Myths {...myths} />
		<Reviews {...reviews} />
		<BookingOnline {...booking} phone={demoSlate.contacts.phoneDisplay ?? demoSlate.contacts.phone} />
		<ContactsMap {...contacts} contacts={demoSlate.contacts} />
	</main>
	<Footer config={demoSlate} privacyHref="/template-lashes/privacy/" />
</Base>
