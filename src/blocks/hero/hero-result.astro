---
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";

interface Props {
	eyebrow: string;
	title: string;
	text: string;
	primaryCta: { label: string; href: string };
	secondaryCta: { label: string; href: string };
	image?: { src: string; alt: string };
	imageLabel: string;
}

const { eyebrow, title, text, primaryCta, secondaryCta, image, imageLabel } = Astro.props;
---

<section id="hero" data-block="hero-result">
	<div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-10 xl:grid-cols-2 xl:gap-12 xl:px-8 xl:py-16">
		<div>
			<p class="text-sm text-muted">{eyebrow}</p>
			<h1 class="mt-3 font-heading text-[36px] leading-[1.15] xl:text-[56px]">{title}</h1>
			<p class="mt-4 max-w-xl font-body text-base leading-relaxed">{text}</p>
			<div class="mt-6 flex flex-col gap-3 xl:flex-row">
				<a
					href={primaryCta.href}
					class="inline-flex min-h-11 w-full items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast xl:w-auto"
				>
					{primaryCta.label}
				</a>
				<a
					href={secondaryCta.href}
					class="inline-flex min-h-11 w-full items-center justify-center rounded-theme border border-primary px-5 text-primary xl:w-auto"
				>
					{secondaryCta.label}
				</a>
			</div>
		</div>
		<div class="overflow-hidden rounded-theme">
			{
				image ? (
					<img src={image.src} alt={image.alt} class="aspect-[4/5] w-full object-cover" />
				) : (
					<PhotoPlaceholder label={imageLabel} ratio="4/5" />
				)
			}
		</div>
	</div>
</section>
