---
import { typograf } from "../../lib/typograf";

interface PriceItem {
	name: string;
	forWhom: string;
	duration: string;
	price: number;
}

interface Props {
	title: string;
	/** Рядок під заголовком. Якщо не передано — одразу кнопка. */
	intro?: string;
	items: PriceItem[];
	subscription?: string;
	cta: { label: string; href: string };
	/** Символ валюти з мовного каталогу, наприклад ₴. */
	currency: string;
	/** Три колонки вже з 641px. Без пропса — з 1024px, як раніше. */
	columnsFrom640?: boolean;
}

const { title, intro, items, subscription, cta, currency, columnsFrom640 = false } = Astro.props;

function money(price: number) {
	const formatted = new Intl.NumberFormat("uk-UA", { maximumFractionDigits: 0 }).format(price);
	return `${formatted}\u00A0${currency}`;
}
---

<section id="prices" data-block="prices-simple">
	<div class="mx-auto grid max-w-6xl min-w-0 gap-8 px-4 py-12 lg:grid-cols-12 lg:items-stretch lg:gap-x-10 xl:px-8">
		<div class="contents lg:sticky lg:top-[calc(var(--header-height,4.25rem)+16px)] lg:col-span-4 lg:flex lg:flex-col lg:self-start">
			<h2 class="order-1 text-3xl lg:order-none">{typograf(title)}</h2>
			{
				intro && (
					<p class="order-2 font-body text-base leading-relaxed lg:order-none lg:mt-4">{typograf(intro)}</p>
				)
			}
			<a
				href={cta.href}
				class:list={[
					"inline-flex min-h-11 w-full items-center justify-center self-start rounded-theme bg-primary px-5 text-primary-contrast lg:w-auto",
					intro ? "order-4 lg:order-none lg:mt-6" : "order-2 lg:order-none lg:mt-6",
				]}
			>
				{cta.label}
			</a>
		</div>
		<div class="order-3 min-w-0 lg:order-none lg:col-span-8">
			<ul class="m-0 list-none p-0">
				{
					items.map((item) => (
						<li class="border-b border-border py-4 first:pt-0">
							<div
								class:list={[
									"pr-4",
									columnsFrom640
										? "min-[641px]:grid min-[641px]:grid-cols-[minmax(0,1fr)_96px_120px] min-[641px]:items-center min-[641px]:gap-x-6"
										: "lg:grid lg:grid-cols-[minmax(0,1fr)_96px_120px] lg:items-center lg:gap-x-6",
								]}
							>
								<div class="min-w-0">
									<p class="font-heading text-xl leading-snug break-words">{typograf(item.name)}</p>
									<p class="mt-1 font-body text-[15px] leading-[1.5] text-muted">{typograf(item.forWhom)}</p>
								</div>
								<div
									class:list={[
										"mt-3 flex items-baseline justify-between gap-6",
										columnsFrom640 ? "min-[641px]:contents" : "lg:contents",
									]}
								>
									<p class="shrink-0 font-body text-[15px] text-muted">{item.duration}</p>
									<p class="shrink-0 text-right font-heading text-[28px] leading-none text-primary tabular-nums whitespace-nowrap">
										{money(item.price)}
									</p>
								</div>
							</div>
						</li>
					))
				}
			</ul>
			{
				subscription && (
					<p class="py-4 font-body text-[15px] leading-[1.5]">{typograf(subscription)}</p>
				)
			}
		</div>
	</div>
</section>
