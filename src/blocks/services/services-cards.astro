---
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { typograf } from "../../lib/typograf";

interface ServiceItem {
	title: string;
	text: string;
	priceFrom: number;
	linkLabel: string;
	href: string;
	imageLabel: string;
	image?: { src: string; alt: string };
}

interface Props {
	title: string;
	currency: string;
	items: ServiceItem[];
}

const { title, currency, items } = Astro.props;
---

<section id="services" data-block="services-cards">
	<div class="mx-auto max-w-6xl px-4 py-12 xl:px-8 xl:py-16">
		<h2 class="text-3xl">{typograf(title)}</h2>
		<ul class="mt-6 grid list-none grid-cols-1 gap-4 p-0 xl:grid-cols-3">
			{
				items.map((item) => (
					<li class="h-full">
						<article class="flex h-full flex-col overflow-hidden rounded-theme border border-border bg-surface">
							{item.image ? (
								<img src={item.image.src} alt={item.image.alt} class="aspect-[4/3] w-full object-cover" />
							) : (
								<PhotoPlaceholder label={item.imageLabel} ratio="4/3" />
							)}
							<div class="flex flex-1 flex-col p-5">
								<h3 class="text-2xl">{typograf(item.title)}</h3>
								<p class="mt-3 font-body leading-relaxed">{item.text}</p>
								<p class="mt-4 font-heading text-2xl text-primary">
									від {item.priceFrom} {currency}
								</p>
								<a href={item.href} class="mt-auto inline-flex min-h-11 items-center pt-4 text-primary">
									{item.linkLabel}
								</a>
							</div>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>
