---
import type { SiteConfig } from "../../config/types";
import { getUi } from "../../i18n";

interface Props {
	config: SiteConfig;
	/** Якщо не передано, посилання на політику не показуємо. */
	privacyHref?: string;
}

const { config, privacyHref = "" } = Astro.props;
const ui = getUi(config.locale);
const year = new Date().getFullYear();
const order = ui.demo.order;
const plaque = ui.demo.plaque.replaceAll("{author}", config.portfolio.author);
const plaqueBefore = plaque.endsWith(order) ? plaque.slice(0, plaque.length - order.length) : plaque;
---

<footer data-block="layout-footer">
	<div class="border-t border-border">
		<div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-6 font-body text-[15px] sm:flex-row sm:items-center sm:justify-between xl:px-8">
			<p>© {year} {config.name}</p>
			{
				privacyHref && (
					<a href={privacyHref} class="inline-flex min-h-11 items-center text-primary">
						Політика приватності
					</a>
				)
			}
		</div>
	</div>
	{
		config.portfolio.enabled && (
			<div class="border-t border-border bg-surface">
				<p class="mx-auto max-w-6xl px-4 py-3 font-body text-sm xl:px-8">
					{plaqueBefore}
					<a
						href={config.portfolio.contactUrl}
						target="_blank"
						rel="noopener"
						class="inline-flex min-h-11 items-center underline underline-offset-2"
					>
						{order}
					</a>
				</p>
			</div>
		)
	}
</footer>
