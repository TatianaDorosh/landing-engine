---
import { typograf } from "../../lib/typograf";

interface Props {
	name: string;
	title: string;
	text: string;
	amounts: string[];
	validity: string;
	ctaLabel: string;
	ctaHref: string;
	ctaService: string;
}

const { name, title, text, amounts, validity, ctaLabel, ctaHref, ctaService } = Astro.props;
---

<section id="gifts" data-block="gifts-certificates">
	<div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-12 lg:grid-cols-12 xl:px-8">
		<div class="flex aspect-[16/10] min-w-0 flex-col justify-between rounded-theme border border-primary-contrast bg-primary p-6 text-primary-contrast lg:col-span-6">
			<p class="font-heading text-3xl">{name}</p>
			<p class="text-lg">Подарунковий сертифікат</p>
		</div>
		<div class="min-w-0 lg:col-span-6">
			<h2 class="text-3xl">{typograf(title)}</h2>
			<ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
				{
					amounts.map((amount) => (
						<li class="inline-flex min-h-11 items-center rounded-full border border-border px-4">{amount}</li>
					))
				}
			</ul>
			<p class="mt-4 leading-relaxed">{text}</p>
			<p class="mt-3 font-body text-[15px] leading-[1.5] text-muted">{validity}</p>
			<a
				href={ctaHref}
				data-service={ctaService}
				class="mt-6 inline-flex min-h-11 items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast"
			>
				{ctaLabel}
			</a>
		</div>
	</div>
</section>
