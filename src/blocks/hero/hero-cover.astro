---
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { typograf } from "../../lib/typograf";

interface Props {
	eyebrow: string;
	title: string;
	text: string;
	cta: { label: string; href: string };
	image?: { src: string; alt: string; position?: string; positionDesktop?: string };
}

const { eyebrow, title, text, cta, image } = Astro.props;
const positionDesktop = image?.positionDesktop || "50% 20%";
---

<section
	id="hero"
	data-block="hero-cover"
	class="relative h-[calc(100svh-4.25rem)] overflow-hidden bg-bg lg:h-[max(560px,min(90vh,calc(100svh-4.25rem)))]"
>
	<div class="flex h-full min-w-0 items-end lg:mx-auto lg:grid lg:h-full lg:w-full lg:max-w-6xl lg:grid-cols-12 lg:items-stretch lg:px-4 xl:px-8">
		<div class="absolute inset-0 min-w-0 lg:relative lg:inset-auto lg:col-span-7 lg:col-start-6 lg:row-start-1 lg:h-full lg:overflow-hidden">
			{
				image ? (
					<img
						src={image.src}
						alt={image.alt}
						loading="eager"
						fetchpriority="high"
						decoding="async"
						class="absolute inset-0 h-full w-full object-cover lg:hidden"
						style={image.position ? `object-position: ${image.position}` : undefined}
					/>
				) : (
					<PhotoPlaceholder label={title} class="absolute inset-0 h-full" />
				)
			}
			{
				image && (
					<img
						src={image.src}
						loading="eager"
						decoding="async"
						class="absolute inset-0 hidden h-full w-full object-cover lg:block"
						style={`object-position: ${positionDesktop}`}
						alt={image.alt}
					/>
				)
			}
			<div
				class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg from-10% via-bg/80 via-45% to-transparent lg:hidden"
				aria-hidden="true"
			>
			</div>
			<div
				class="pointer-events-none absolute inset-y-0 left-0 hidden w-1/4 bg-gradient-to-r from-bg to-transparent lg:block"
				aria-hidden="true"
			>
			</div>
		</div>
		<div class="relative z-10 mx-auto w-full min-w-0 max-w-6xl px-4 pb-8 lg:col-span-5 lg:col-start-1 lg:row-start-1 lg:mx-0 lg:flex lg:h-full lg:max-w-none lg:flex-col lg:items-start lg:justify-center lg:py-8 lg:pr-8 lg:pl-0">
			<p class="font-body text-[15px]">{eyebrow}</p>
			<h1 class="mt-3 max-w-3xl font-heading text-[36px] leading-[1.15] lg:text-[clamp(2.25rem,0.6rem+2.8vw,3.25rem)]">{typograf(title)}</h1>
			<p class="mt-4 max-w-xl font-body text-base leading-relaxed">{text}</p>
			<a
				href={cta.href}
				class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast lg:w-auto"
			>
				{cta.label}
			</a>
		</div>
	</div>
</section>
