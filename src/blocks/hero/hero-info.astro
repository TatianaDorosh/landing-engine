---
import { typograf } from "../../lib/typograf";

interface Props {
	title: string;
	text: string;
	points?: string[];
	primaryCta: { label: string; href: string; service?: string };
	secondaryCta: { label: string; href: string };
	card: {
		title: string;
		hours: string;
		address: string;
		note: string;
	};
}

const { title, text, points = [], primaryCta, secondaryCta, card } = Astro.props;
---

<section id="hero" data-block="hero-info">
	<div
		class="mx-auto grid max-w-6xl items-stretch gap-6 px-4 py-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-x-10 lg:px-8 lg:py-12"
	>
		<div class="flex min-w-0 flex-col">
			<h1 class="font-heading text-[36px] leading-[1.15] lg:text-[56px]">{typograf(title)}</h1>
			<p class="mt-4 max-w-xl font-body text-base leading-relaxed">{text}</p>
			{
				points.length > 0 && (
					<ul class="mt-4 flex list-none flex-col gap-2 p-0">
						{points.map((point) => (
							<li class="flex items-start gap-2 font-body text-base">
								<span class="text-primary" aria-hidden="true">
									✓
								</span>
								<span>{point}</span>
							</li>
						))}
					</ul>
				)
			}
			<div class="mt-6 flex w-full flex-col items-start gap-3 lg:mt-auto lg:w-auto lg:flex-row lg:pt-8">
				<a
					href={primaryCta.href}
					data-service={primaryCta.service}
					class="inline-flex min-h-11 w-full items-center justify-center rounded-theme bg-primary px-5 text-primary-contrast lg:w-auto"
				>
					{primaryCta.label}
				</a>
				<a
					href={secondaryCta.href}
					class="inline-flex min-h-11 w-full items-center justify-center rounded-theme border border-primary px-5 text-primary lg:w-auto"
				>
					{secondaryCta.label}
				</a>
			</div>
		</div>
		<div class="min-w-0 rounded-theme border border-border bg-surface p-5 lg:p-6">
			<p class="font-body text-lg font-semibold leading-snug">{card.title}</p>
			<ul class="mt-4 flex list-none flex-col gap-3 p-0">
				<li class="font-body text-[15px] leading-relaxed">{card.hours}</li>
				<li class="font-body text-[15px] leading-relaxed">{card.address}</li>
				<li class="font-body text-[15px] leading-relaxed">{card.note}</li>
			</ul>
		</div>
	</div>
</section>
